# Captured source bytes and immutable batch inputs must survive Git transport.
data/evidence/snapshots/*.txt -text
data/evidence/raw/*.bin -text
nemesis/batches/** -text
# Unified patches require a literal space on empty context lines.
nemesis/integration/*.patch -text whitespace=-blank-at-eol
# Exact retained Brain 6.2.7 source hashes and reversible patch bytes.
nemesis/integration/blank-composer/** -text whitespace=cr-at-eol
nemesis/integration/blank-composer/upgrade.patch whitespace=cr-at-eol,-blank-at-eol
# Exact retained Brain 6.2.8 source hashes and reversible patch bytes.
nemesis/integration/text-first/** -text whitespace=cr-at-eol
nemesis/integration/text-first/upgrade.patch whitespace=cr-at-eol,-blank-at-eol
