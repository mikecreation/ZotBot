{"numberOfHits":1,"results":[{"id":"GO:0044010","isObsolete":false,"name":"single-species biofilm formation","definition":{"text":"A process in which planktonically growing microorganisms of the same species grow at a liquid-air interface or on a solid substrate under the flow of a liquid and produce extracellular polymers that facilitate matrix formation, resulting in a change in the organisms' growth rate and gene transcription."},"synonyms":[{"name":"auto-aggregation","type":"broad"},{"name":"bfp-dependent aggregation","type":"narrow"},{"name":"bundle-forming fimbriae-dependent aggregation","type":"narrow"},{"name":"bundle-forming pili-dependent aggregation","type":"narrow"},{"name":"tfp-dependent aggregation","type":"narrow"},{"name":"type IV pili-dependent aggregation","type":"narrow"}],"children":[{"id":"GO:1900190","relation":"regulates"},{"id":"GO:1900192","relation":"positively_regulates"},{"id":"GO:0044407","relation":"is_a"},{"id":"GO:0090606","relation":"is_a"},{"id":"GO:1900191","relation":"negatively_regulates"},{"id":"GO:0090609","relation":"is_a"},{"id":"GO:0043709","relation":"part_of"}],"secondaryIds":["GO:0052000"],"history":[{"timestamp":"2020-02-22","action":"Added","category":"SYNONYM","text":"auto-aggregation"},{"timestamp":"2020-02-22","action":"Added","category":"SYNONYM","text":"bundle-forming fimbriae-dependent aggregation"},{"timestamp":"2020-02-22","action":"Added","category":"SYNONYM","text":"bundle-forming pili-dependent aggregation"},{"timestamp":"2020-02-22","action":"Added","category":"SYNONYM","text":"bfp-dependent aggregation"},{"timestamp":"2020-02-22","action":"Added","category":"SYNONYM","text":"type IV pili-dependent aggregation"},{"timestamp":"2020-02-22","action":"Added","category":"SYNONYM","text":"tfp-dependent aggregation"},{"timestamp":"2020-02-22","action":"Added","category":"SECONDARY","text":"GO:0052000 (type IV pili-dependent aggregation)"},{"timestamp":"2020-02-22","action":"Added","category":"RELATION","text":"is a