        <dt>Unique ID</dt><dd>D011578</dd>

        <dt>RDF Unique Identifier</dt>
        <dd><a href="https://id.nlm.nih.gov/mesh/D011578.html">
            http://id.nlm.nih.gov/mesh/D011578
        </a></dd>

        <span id="annotation">
            <dt>Annotation</dt><dd>coordinate with specific linguistic & psychological concepts</dd>
        </span>
                <span id="scopeNote">
                    <dt>Scope Note</dt><dd>A discipline concerned with relations between messages and the characteristics of individuals who select and interpret them; it deals directly with the processes of encoding (phonetics) and decoding (psychoacoustics) as they relate states of messages to states of communicators.</dd>
                </span>
            
                <dt>Previous Indexing</dt>
                
                    <dd>Language (1966)</dd>
                
                <dt>See Also</dt>
                
                    <dd><a id="seeAlso_LanguageDevelopment"
                           href="/record/ui?ui=D007804"
                        >Language Development</a></dd>
                
            <dt>Public MeSH Note</dt><dd>67</dd>
        
            <dt>History Note</dt><dd>67</dd>
        
        


        
                <dt>Date Introduced</dt>
                <dd>1967/01/01</dd>
            
