{"batchcomplete":true,"query":{"pages":[{"pageid":900867,"ns":0,"title":"Drilling","extract":"Drilling is a cutting process where a drill bit is spun to cut a hole of circular cross-section in solid materials. The drill bit is usually a rotary cutting tool, often multi-point.","description":"Cutting process that uses a drill bit to cut a circular hole into the workpiece","descriptionsource":"local"}]}}