{"batchcomplete":true,"query":{"pages":[{"pageid":13018310,"ns":0,"title":"Argument","extract":"An argument is one or more premises—sentences, statements, or propositions—directed towards arriving at a logical conclusion. The purpose of an argument is to give reasons for one's thinking and understanding via justification, explanation, or persuasion.","description":"Attempt to persuade or to determine the truth of a conclusion","descriptionsource":"local"}]}}