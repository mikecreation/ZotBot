{"version":"6.9","hitCount":1,"request":{"queryString":"EXT_ID:42788599 AND SRC:MED","internalQuery":"EXT_ID:42788599 AND SRC:MED","resultType":"CORE","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"42788599","source":"MED","pmid":"42788599","pmcid":"PMC13588563","fullTextIdList":{"fullTextId":["PMC13588563"]},"doi":"10.1590/s1678-9946202668062","title":"Septic arthritis caused by Nocardia asiatica: a case report and narrative review.","authorString":"Yildiz M.","authorList":{"author":[{"fullName":"Yildiz M","lastName":"Yildiz","firstName":"Mehmet","initials":"M","authorId":{"type":"ORCID","value":"0000-0001-8528-2163"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ministry of Health Karadeniz Ereğli State Hospital, Zonguldak, Turkey."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8528-2163"}]},"journalInfo":{"volume":"68","journalIssueId":4117078,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Rev Inst Med Trop Sao Paulo","title":"Revista do Instituto de Medicina Tropical de Sao Paulo","essn":"1678-9946","issn":"0036-4665","nlmid":"7507484","isoabbreviation":"Rev Inst Med Trop Sao Paulo"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"e62","abstractText":"Nocardia asiatica is a rare opportunistic pathogen typically associated with pulmonary and central nervous system infections; however, musculoskeletal infections are uncommon. We report a case of septic arthritis caused by N. asiatica in a 72-year-old man with a history of chronic obstructive pulmonary disease (COPD) and pneumoconiosis. The patient presented with subacute knee swelling following a recent episode of pneumonia. Gram staining of intraoperative synovial samples revealed branching filamentous organisms, and the isolate was identified as N. asiatica by mass spectrometry. Although the patient was transferred to another center during the initial phase of management, follow-up information obtained after discharge confirmed a favorable clinical recovery without recurrence. Our report contributes to the limited literature on the clinical manifestations, organ tropism, and antimicrobial susceptibility patterns associated with N. asiatica infection.","affiliation":"Ministry of Health Karadeniz Ereğli State Hospital, Zonguldak, Turkey.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Review","Journal Article","Case Reports","case-report"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Nocardia","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CL","qualifierName":"classification"},{"majorTopic_YN":"N","abbreviation":"IP","qualifierName":"isolation & purification"}]}},{"majorTopic_YN":"Y","descriptorName":"Nocardia Infections","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DI","qualifierName":"diagnosis"},{"majorTopic_YN":"N","abbreviation":"DT","qualifierName":"drug therapy"},{"majorTopic_YN":"N","abbreviation":"MI","qualifierName":"microbiology"}]}},{"majorTopic_YN":"Y","descriptorName":"Arthritis, Infectious","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DI","qualifierName":"diagnosis"},{"majorTopic_YN":"N","abbreviation":"DT","qualifierName":"drug therapy"},{"majorTopic_YN":"N","abbreviation":"MI","qualifierName":"microbiology"}]}},{"majorTopic_YN":"N","descriptorName":"Anti-Bacterial Agents","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"TU","qualifierName":"therapeutic use"}]}},{"majorTopic_YN":"N","descriptorName":"Aged"},{"majorTopic_YN":"N","descriptorName":"Male"}]},"chemicalList":{"chemical":[{"name":"Anti-Bacterial Agents","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1590/S1678-9946202668062"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13588563"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13588563?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-09-25","dateOfCreation":"2026-09-25","dateOfRevision":"2026-09-29","electronicPublicationDate":"2026-09-18","firstPublicationDate":"2026-09-18","firstIndexDate":"2026-09-26","fullTextReceivedDate":"2026-09-19","hasEvaluations":"N"}]}}