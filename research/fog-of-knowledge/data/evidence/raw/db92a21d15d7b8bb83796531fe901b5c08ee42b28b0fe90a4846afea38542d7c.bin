:"navid.golpayegani-1",research:[]},{phonebook_id:18164,uupic:"809882146",email_address:"sylvain.g.guiriec@nasa.gov",first_name:"Sylvain",middle_initial:"Germain",last_name:"Guiriec",phone:"301.286.0643",org_code:z,mail_code:z,affiliation:"George Washington University",bio:"sylvain.g.guiriec",research:[],photo:"\u002Fimages\u002FPhotos\u002F18164\u002F\u002FGuiriec,_Sylvain.jpg"},{phonebook_id:121170,uupic:"181273479",email_address:"rahul.gupta@nasa.gov",first_name:"Rahul",middle_initial:b,last_name:"Gupta",phone:b,org_code:z,mail_code:b,affiliation:"NPP POST-DOC CONTRACT",bio:"rahul.gupta",research:[],photo:"\u002Fimages\u002FPhotos\u002F121170\u002F\u002F2422024204948_Gupta, Rahul 661b.jpg"},{phonebook_id:99867,uupic:"697321233",email_address:"sophia.e.haight@nasa.gov",first_name:"Sophia",middle_initial:dB,last_name:"Haight",phone:"847.373.9114",org_code:z,mail_code:z,affiliation:t,bio:"sophia.e.haight",research:[]},{phonebook_id:48619,uupic:"702699703",email_address:"jeremy.hare@nasa.gov",first_name:hy,middle_initial:b,last_name:"Hare",phone:rF,org_code:z,mail_code:z,affiliation:bd,bio:"jeremy.hare",research:[]},{phonebook_id:17930,uupic:"799463330",email_address:"elizabeth.a.hays@nasa.gov",first_name:dB,middle_initial:fB,last_name:"Hays",phone:"301.286.0345",org_code:z,mail_code:z,affiliation:t,bio:"elizabeth.a.hays",research:[],photo:"\u002Fimages\u002FPhotos\u002F17930\u002F\u002FHays,_Elizabeth.jpg"},{phonebook_id:119155,uupic:"669194046",email_address:"hyebin.jeon@nasa.gov",first_name:"Hyebin",middle_initial:b,last_name:"Jeon",phone:b,org_code:z,mail_code:b,affiliation:kN,bio:"hyebin.jeon",research:[]},{phonebook_id:39650,uupic:"551182256",email_address:"timothy.joubert@nasa.gov",first_name:eH,middle_initial:b,last_name:"Joubert",phone:b,org_code:z,mail_code:b,affiliation:"U.S. DEPARTMENT OF DEFENSE",bio:"timothy.joubert",research:[]}],alphabet:[{letter:F,count:u},{letter:kO,count:A},{letter:kP,count:af},{letter:kQ,count:J},{letter:kR,count:u},{letter:kS,count:u},{letter:kT,count:W},{letter:kU,count:J},{letter:hF,count:f},{letter:kV,count:v},{letter:kW,count:av},{letter:kX,count:J},{letter:kY,count:by},{letter:kZ,count:R},{letter:k_,count:f},{letter:k$,count:W},{letter:la,count:f},{letter:lb,count:W},{letter:lc,count:ba},{letter:ld,count:u},{letter:le,count:f},{letter:lf,count:W},{letter:lg,count:R},{letter:lh,count:f},{letter:G,count:f},{letter:li,count:u}],recordcount:f,screenWidth:f},bio:{loading:e,bio:{}},missions:{featuredMissions:[{id:lj,code:dC,disp:rM,acronym:a,desc_short:"Dragonfly is a rotorcraft lander mission proposed to the New Frontiers Program that is designed to take advantage of Titan's environment to be able to sample materials and determine the surface composition in different geologic settings. This revolutionary mission concept would provide the capability to explore diverse locations to characterize the habitability of Titan's environment, to investigate how far prebiotic chemistry has progressed, and even to search for chemical signatures that could be indicative of water-based and\u002For hydrocarbon-based life. ",desc:a,url_home:"http:\u002F\u002Fdragonfly.jhuapl.edu\u002F",url_epo:a,url_staff:a,org_codes:fF,launch_year:a,launch_month:a,launch_day:a,image:rN,image_alt:rO,status:lk,instruments:[],staff:[{role_disp:"Science Team Member",org_code:a,uupic:ll,prx_first_name:a,prx_last_name:a,prx_mid_name:a,pb_last_name:lm,pb_first_name:ln,pb_mid_name:aq,p_org_code:aA,phonebook_id:lo,bio:"lynnae.c.quick",active:e},{role_disp:hG,org_code:fF,uupic:rP,prx_first_name:rQ,prx_last_name:rR,prx_mid_name:rS,pb_last_name:rT,pb_first_name:dD,pb_mid_name:rU,p_org_code:w,phonebook_id:rV,bio:rW,active:e},{role_disp:be,org_code:fF,uupic:rX,prx_first_name:bz,prx_last_name:hH,prx_mid_name:ao,pb_last_name:hH,pb_first_name:bz,pb_mid_name:ao,p_org_code:y,phonebook_id:rY,bio:rZ,active:e},{role_disp:be,org_code:fF,uupic:"625927132",prx_first_name:"ANN",prx_last_name:"PARSONS",prx_mid_name:ac,pb_last_name:"Parsons",pb_first_name:dA,pb_mid_name:ac,p_org_code:P,phonebook_id:14045,bio:"ann.m.parsons",active:m}]},{id:r_,code:dE,disp:"Dragonfly - DraMS (Dragonfly Mass spectrometer)",acronym:"DraMS",desc_short:"A central element of the payload is a highly capable mass spectrometer instrument, with front-end sample processing able to handle highmolecular-weight materials and samples of prebiotic interest. The system has elements from the highly successful SAM (Sample Analysis at Mars) instrument on Curiosity, which has pyrolysis and gas chromatographic analysis capabilities, and also draws on developments for the ExoMars\u002FMOMA (Mars Organic Material Analyser). ",desc:a,url_home:a,url_epo:a,url_staff:a,org_codes:r$,launch_year:a,launch_month:a,launch_day:a,image:"images\u002Fmission_thumbs\u002FDragonfly_flying.jpg",image_alt:"Artist rendering of Dragonfly flying over Mars",status:lk,instruments:[],staff:[{role_disp:"Calibration Team Member",org_code:a,uupic:sa,prx_first_name:a,prx_last_name:a,prx_mid_name:a,pb_last_name:sb,pb_first_name:hI,pb_mid_name:fG,p_org_code:w,phonebook_id:sc,bio:sd,active:e},{role_disp:hG,org_code:r$,uupic:rP,prx_first_name:rQ,prx_last_name:rR,prx_mid_name:rS,pb_last_name:rT,pb_first_name:dD,pb_mid_name:rU,p_org_code:w,phonebook_id:rV,bio:rW,active:e}]},{id:fH,code:dE,disp:hJ,acronym:hK,desc_short:se,desc:sf,url_home:sg,url_epo:sh,url_staff:a,org_codes:w,launch_year:si,launch_month:fI,launch_day:sj,image:hL,image_alt:hM,status:bJ,instruments:[],staff:[{role_disp:lp,org_code:w,uupic:lq,prx_first_name:hN,prx_last_name:sk,prx_mid_name:S,pb_last_name:sl,pb_first_name:bp,pb_mid_name:S,p_org_code:w,phonebook_id:lr,bio:"charles.a.malespin",active:e},{role_disp:hG,org_code:w,uupic:ls,prx_first_name:aY,prx_last_name:sm,prx_mid_name:eI,pb_last_name:sn,pb_first_name:aY,pb_mid_name:eI,p_org_code:w,phonebook_id:lt,bio:"amy.mcadam-1",active:e}]},{id:eJ,code:dC,disp:fJ,acronym:fK,desc_short:so,desc:sp,url_home:sq,url_epo:sr,url_staff:ss,org_codes:dF,launch_year:lu,launch_month:fI,launch_day:st,image:fL,image_alt:fM,status:bJ,instruments:[],staff:[{role_disp:su,org_code:a,uupic:lv,prx_first_name:a,prx_last_name:a,prx_mid_name:a,pb_last_name:sv,pb_first_name:sw,pb_mid_name:aX,p_org_code:w,phonebook_id:lw,bio:"jaykumar.j.vaidya",active:e},{role_disp:cD,org_code:a,uupic:lx,prx_first_name:a,prx_last_name:a,prx_mid_name:a,pb_last_name:sx,pb_first_name:hO,pb_mid_name:sy,p_org_code:ds,phonebook_id:ly,bio:"rachel.e.maxwell",active:e},{role_disp:dG,org_code:dF,uupic:sz,prx_first_name:lz,prx_last_name:sA,prx_mid_name:ac,pb_last_name:sB,pb_first_name:bL,pb_mid_name:ac,p_org_code:ds,phonebook_id:sC,bio:"joseph.m.grebowsky",active:m},{role_disp:hP,org_code:dF,uupic:hQ,prx_first_name:eK,prx_last_name:eL,prx_mid_name:a,pb_last_name:eL,pb_first_name:eK,pb_mid_name:b,p_org_code:w,phonebook_id:hR,bio:sD,active:e}]},{id:lA,code:dC,disp:sE,acronym:sF,desc_short:"NASA's Lunar Atmosphere and Dust Environment Explorer (LADEE) - pronounced \"laddie\" - was a robotic mission that orbited the moon to gather detailed information about the structure and composition of the thin lunar atmosphere, and determine whether dust is lofted into the lunar sky. A thorough understanding of these characteristics of our nearest celestial neighbor will help researchers understand other bodies in the solar system, such as large asteroids, Mercury, and the moons of outer planets. ",desc:"\t\t\t\t\t\tThe Lunar Atmosphere and Dust Environment Explorer was a NASA lunar exploration and technology demonstration mission. \r\nIt was launched on a Minotaur V rocket from the Mid-Atlantic Regional Spaceport on September 7, 2013.\r\nDuring its seven-month mission, LADEE orbited the Moon's equator, using its instruments to study the lunar exosphere and dust in the Moon's vicinity. \r\nInstruments included a dust detector, neutral mass spectrometer, and ultraviolet-visible spectrometer, as well as a technology demonstration consisting of a laser communications terminal.\r\nThe mission ended on April 18, 2014, when the spacecraft's controllers intentionally crashed LADEE into the far side of the Moon, which, later, was determined to be near the eastern rim of Sundman V crater.\t\r\n\t\t\t\t\t",url_home:"https:\u002F\u002Fscience.nasa.gov\u002Fmission\u002Fladee",url_epo:a,url_staff:a,org_codes:w,launch_year:lu,launch_month:sG,launch_day:lB,image:sH,image_alt:sI,status:"past",instruments:[],staff:[{role_disp:be,org_code:w,uupic:hQ,prx_first_name:eK,prx_last_name:eL,prx_mid_name:a,pb_last_name:eL,pb_first_name:eK,pb_mid_name:b,p_org_code:w,phonebook_id:hR,bio:sD,active:e},{role_disp:be,org_code:w,uupic:"759519862",prx_first_name:bK,prx_last_name:sJ,prx_mid_name:a,pb_last_name:sJ,pb_first_name:bK,pb_mid_name:bf,p_org_code:y,phonebook_id:17033,bio:"paul.r.mahaffy",active:e}]},{id:sK,code:dE,disp:"Mars Organic Molecule Analyzer",acronym:"MOMA",desc_short:"The MOMA instrument is provided to the ExoMars mission with a European and US teaming collaboration that integrates a Goddard linear ion trap mass spectrometer with a French provided gas chromatograph and a laser provided by Germany. The goal of this highly capable instrument is to detect and identify organic material from below the surface of Mars that is delivered to MOMA by a drill on the rover. This drill can acquire sample from up to 2 meters below the surface. At that depth organic molecules are better protected from destruction by the high energy radiation that penetrates through the thin martian atmosphere. The primary goal of the mission is to search for organic molecules of biotic or prebiotic relevance that may give us clues about possible microbial life on ancient Mars at a time where surface water was abundant. ",desc:a,url_home:"https:\u002F\u002Fmars.nasa.gov\u002Fprogrammissions\u002Fmissions\u002Ffuture\u002Fesa-2020-exomars-rover\u002F",url_epo:a,url_staff:a,org_codes:w,launch_year:a,launch_month:a,launch_day:a,image:"images\u002Fmission_thumbs\u002F368_esa-exomars-2020-rover.jpg",image_alt:"ESA ExoMars Rover",status:lk,instruments:[],staff:[{role_disp:"Product Development Lead",org_code:a,uupic:sa,prx_first_name:a,prx_last_name:a,prx_mid_name:a,pb_last_name:sb,pb_first_name:hI,pb_mid_name:fG,p_org_code:w,phonebook_id:sc,bio:sd,active:e},{role_disp:dG,org_code:w,uupic:rX,prx_first_name:bz,prx_last_name:hH,prx_mid_name:ao,pb_last_name:hH,pb_first_name:bz,pb_mid_name:ao,p_org_code:y,phonebook_id:rY,bio:rZ,active:e}]}],alphabeticalMissions:{recordCount:R,alphabet:[{letter:F,count:c},{letter:kO,count:f},{letter:kP,count:f},{letter:kQ,count:f},{letter:kR,count:f},{letter:kS,count:f},{letter:kT,count:f},{letter:kU,count:f},{letter:hF,count:f},{letter:kV,count:f},{letter:kW,count:f},{letter:kX,count:f},{letter:kY,count:c},{letter:kZ,count:f},{letter:k_,count:u},{letter:k$,count:f},{letter:la,count:f},{letter:lb,count:f},{letter:lc,count:s},{letter:ld,count:f},{letter:le,count:f},{letter:lf,count:f},{letter:lg,count:c},{letter:lh,count:f},{letter:G,count:f},{letter:li,count:f}],visualDataByClass:[{code:fN,name:cd,description:cd,value:s},{code:sL,name:sM,description:sN,value:c},{code:sO,name:sP,description:sQ,value:c},{code:sR,name:hS,description:hS,value:c},{code:a,name:"No Class",description:"Projects without a classification",value:u}],visualDataByDivision:[{name:ay,value:sS},{name:az,value:hT},{name:aW,value:lC},{name:y,value:hT}],records:[{id:sT,code:dE,disp:"Arctic Mars Analogue Svalbard Expedition",acronym:"AMASE",desc_short:"AMASE has established Svalbard as a test bed for life-detection technology that will be used on future NASA and ESA 'Search for Life' mission to Mars.",desc:"Since 2003 the Arctic Mars Analogue Svalbard Expedition (AMASE) has been traveling to field sites on Svalbard to test the protocols, procedures and equipment needed to detect traces of organic chemistry and perhaps life on Mars. The AMASE crew over the years has consisted of over a hundred scientists and engineers from institutions around the world.",url_home:"http:\u002F\u002Fonorbit.com\u002FAMASE",url_epo:"http:\u002F\u002Fwww.planetary.org\u002Fexplore\u002Ftopics\u002Fplanetary_analogs\u002Fsvalbard_2009.html",url_staff:a,org_codes:w,launch_year:a,launch_month:a,launch_day:a,logo_image:a,logo_image_alt:a,image:"images\u002Fmission_thumbs\u002Famase.jpg",image_alt:"AMASE logo",status:bJ,status_display:cE,class:[{projectClassTypeCode:sL,projectClassTypeDisp:sM,projectClassTypeDesc:sN,lastUpdateDate:dH,lastUpdateUser:dI}],instruments:[],staff:[]},{id:eJ,code:dC,disp:fJ,acronym:fK,desc_short:so,desc:sp,url_home:sq,url_epo:sr,url_staff:ss,org_codes:dF,launch_year:lu,launch_month:fI,launch_day:st,logo_image:"244-maven.avif",logo_image_alt:a,image:fL,image_alt:fM,status:bJ,status_display:cE,class:[{projectClassTypeCode:fN,projectClassTypeDisp:cd,projectClassTypeDesc:cd,lastUpdateDate:dH,lastUpdateUser:dI}],instruments:[],staff:[{uupic:lv,auid:"jvaidya",roleDisp:su,orgCode:w,phonebookId:lw,email:"jaykumar.j.vaidya@nasa.gov",firstName:a,lastName:a,midName:a,pbLastName:sv,pbFirstName:sw,pbMidName:aX,phonebook:{details:{bio:"\u002Fsci\u002Fbio\u002Fjaykumar.j.vaidya",org:w,publication_selected:m,phonebook_id:lw,photo:"\u002Fimages\u002FPhotos\u002F104393\u002F2602025124326_nasa_headshot.jpg",role:"FACULTY RESEARCH ASST",sed_display_name:"Jaykumar J Vaidya",uupic:lv,active:e},research:[{id:cS,discipline_id:s,discipline:T,category:cT}],missions:[{project_id:636,project_disp:"Geospace Dynamics Constellation",project_org_code:hp,project_acronym:"GDC",project_image:"images\u002Fmission_thumbs\u002Fgdc.png",project_image_alt:"GDC logo, stylized sun behind the Earth with a magnetic field"},{project_id:eJ,project_disp:fJ,project_org_code:dF,project_acronym:fK,project_image:fL,project_image_alt:fM},{project_id:lD,project_disp:sU,project_org_code:w,project_acronym:sV,project_image:sW,project_image_alt:sX},{project_id:sY,project_disp:sZ,project_org_code:w,project_acronym:a,project_image:s_,project_image_alt:s$},{project_id:633,project_disp:"Modular Spectrom