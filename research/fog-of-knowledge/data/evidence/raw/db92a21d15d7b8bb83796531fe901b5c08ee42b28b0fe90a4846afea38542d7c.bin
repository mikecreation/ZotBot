ily in the infrared range of the electromagnetic spectrum, with some capability in the visible range. The observatory was launched on Dec 25, 2021. ",projectDesc:a,project3dUrl:"https:\u002F\u002Feyes.nasa.gov\u002Fapps\u002Fsolar-system\u002F#\u002Fsc_jwst",urlProjectHome:"https:\u002F\u002Fscience.nasa.gov\u002Fmission\u002Fwebb\u002F",urlProjectEpo:a,urlStaff:a,projectOrgCode:ah,launchDate:a,projectStatusTypeCode:bJ,projectImage:ai,projectImageAlt:aj,projectLogoImage:"131-jwst.avif",projectLogoImageAlt:a,launchDateString:a,launchDateDay:"25",launchDateMonth:"12",launchDateYear:"2021",additionalInformation:a,projectStatusTypeDisp:cE,projectStatusTypeDesc:"Current",publications:[[{dates:a,day:af,document_path:a,doi:"10.1117\u002F1.JATIS.3.4.044002",filename:a,document_name:a,url:a,found_in:a,isbn:a,issue:mh,location:a,month:W,org_code:az,pages:"044202",publication_name:mi,publication_type_id:c,publisher:a,pub_id:35375,refereed:G,status:F,status_id:c,title:"Model-based thermal system design optimization for the James Webb Space Telescope",volume:gk,year:2017,first_author_affiliation:ci,publications_projects:[{project_id:ad,project_disp:ag,project_org_code:ah,project_acronym:ae,project_image_alt:aj,project_image:ai}],publication_status_value:L,publication_type_value:M,publications_authors:[{author_order:c,uupic:iq,first_name:"GIUSEPPE",middle_name:a,last_name:"CATALDO",isTeam:f,display_name:vJ,phonebook:{uupic:iq,phonebook_id:vK,first_name:gl,middle_initial:b,last_name:gm,display_name:vL,common_name:vM,email_address:ir,phone:vN,mobile:b,fax:b,address:p,zip:q,city:r,center:h,mail_code:au,title:vO,org_code:vP,state:o,building:vQ,employer:t,room:vR,agency_user_id:vS,legacy_id:vT,x500_id:vU,us_citizen:g,status:j,f_photo_visible_to_public:d,cv:a,created_date:eU,last_update_date:l,last_update_user:a,title_name:N,f_ned:d,sl_first_name:gl,sl_middle_initial:b,sl_last_name:gm,f_ned_identitystatus:k,display_job_title:c,set_job_title_primary_role:c,mail_code_show_name:c,org_code