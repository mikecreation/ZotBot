<script type="text/template" id="signpostsTemplate">
    <li id="almSaves">
      <%= s.numberFormat(saveCount, 0) %>
      <div class="tools" data-js-tooltip-hover="trigger">
        <a class="metric-term" href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#savedHeader">Save</a>
        <p class="saves-tip" data-js-tooltip-hover="target"><a href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#savedHeader">Total Mendeley and Citeulike bookmarks.</a></p>
      </div>
    </li>

    <li id="almCitations">
      <%= s.numberFormat(citationCount, 0) %>
      <div class="tools" data-js-tooltip-hover="trigger">
        <a class="metric-term" href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#citedHeader">Citation</a>
        <p class="citations-tip" data-js-tooltip-hover="target"><a href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#citedHeader">Paper's citation count computed by Dimensions.</a></p>
      </div>
    </li>

    <li id="almViews">
      <%= s.numberFormat(viewCount, 0) %>
      <div class="tools" data-js-tooltip-hover="trigger">
        <a class="metric-term" href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#viewedHeader">View</a>
        <p class="views-tip" data-js-tooltip-hover="target"><a href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#viewedHeader">PLOS views and downloads.</a></p>
      </div>
    </li>

    <li id="almShares">
      <%= s.numberFormat(shareCount, 0) %>
      <div class="tools" data-js-tooltip-hover="trigger">
        <a class="metric-term" href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#discussedHeader">Share</a>
        <p class="shares-tip" data-js-tooltip-hover="target"><a href="/plosgenetics/article/metrics?id=10.1371/journal.pgen.1007348#discussedHeader">Sum of Facebook, Twitter, Reddit and Wikipedia activity.</a></p>
      </div>
    </li>
</script>

