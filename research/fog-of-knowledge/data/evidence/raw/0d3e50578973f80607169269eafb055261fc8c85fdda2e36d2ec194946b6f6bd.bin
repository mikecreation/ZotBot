        <dt>MeSH Heading      </dt>

        <dd>Helplessness, Learned</dd>

        
                    <dt>Tree Number(s)</dt>
                    
                        <dd><a id="treeNumber_0" onclick=
                               "switchTab([ 'trees', 'treesTabContent' ])"
                            >F01.393.398</a></dd>
                    
