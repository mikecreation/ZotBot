{"batchcomplete":true,"query":{"pages":[{"pageid":50408,"ns":0,"title":"Computer engineering","extract":"Computer engineering (CE, CoE, CpE, or CompE) is a branch of engineering specialized in developing computer hardware and software. \n\nIt integrates several fields of electrical engineering, electronics engineering and computer science.","description":"Engineering discipline specializing in the design of computer hardware","descriptionsource":"local"}]}}