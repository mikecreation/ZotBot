age - Basin","package_id":"ec6c66de-25a2-41d5-a58e-e58259c56432","position":1,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/05041838-896f-4d1a-beff-0fd43b5a3e0f/resource/0f1896cd-b366-46bf-81ef-ecbfcf4b0584/download/change_in_storage_totals.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:31:06.503007","datastore_active":false,"description":"","format":"CSV","hash":"bd2e2688a032268fd14fdfa8acacc9a6","id":"36b030d4-9fc1-43dd-86e8-5451b0e41374","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.152655","mimetype":null,"mimetype_inner":null,"name":"Groundwater Extraction","package_id":"ec6c66de-25a2-41d5-a58e-e58259c56432","position":2,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/05041838-896f-4d1a-beff-0fd43b5a3e0f/resource/f5d850d2-8cc1-41de-9df1-0dfdf7b6ce8b/download/groundwater_extraction.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:31:06.503007","datastore_active":false,"description":"","format":"CSV","hash":"3d29c33dd650de7bfb09c8a42edb9305","id":"25609bd4-9326-440c-8880-543adc264d6a","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.152747","mimetype":null,"mimetype_inner":null,"name":"Groundwater Extraction Methods","package_id":"ec6c66de-25a2-41d5-a58e-e58259c56432","position":3,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/05041838-896f-4d1a-beff-0fd43b5a3e0f/resource/6dd66e18-7e6a-4440-96f2-334f3d0e29a4/download/groundwater_extraction_methods.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:31:06.503008","datastore_active":false,"description":"","format":"CSV","hash":"bb3c3b42db5279ad3f02967b5c1ce8ef","id":"d361ff20-b713-4f57-b3a4-65400933b0a1","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.152862","mimetype":null,"mimetype_inner":null,"name":"Surface Water Supply","package_id":"ec6c66de-25a2-41d5-a58e-e58259c56432","position":4,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/05041838-896f-4d1a-beff-0fd43b5a3e0f/resource/153a3415-c0a3-4d5e-81ca-a7569514a487/download/surface_water_supply.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:31:06.503008","datastore_active":false,"description":"","format":"CSV","hash":"0426349da5217585c24a04b2d83bff98","id":"c2f75059-86f0-4aa7-915a-87ea6a471b2e","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.152956","mimetype":null,"mimetype_inner":null,"name":"Total Water Use","package_id":"ec6c66de-25a2-41d5-a58e-e58259c56432","position":5,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/05041838-896f-4d1a-beff-0fd43b5a3e0f/resource/0860c5f6-90e5-426f-b274-58c4bc72c2af/download/total_water_use.csv","url_type":null}],"tags":[{"display_name":"Annual Report","id":"fd35d242-d04b-4b14-b2c7-7b4aed22bd77","name":"Annual Report","state":"active","vocabulary_id":null},{"display_name":"GSP","id":"ebdf7c3a-8efe-461b-a819-538502bb4857","name":"GSP","state":"active","vocabulary_id":null},{"display_name":"GSPAR","id":"75daa5df-ea74-49d4-8bb0-4bb5091c5feb","name":"GSPAR","state":"active","vocabulary_id":null},{"display_name":"Groundwater Sustainability Plan","id":"6220fd27-3e26-4027-9dae-768e88000c8a","name":"Groundwater Sustainability Plan","state":"active","vocabulary_id":null},{"display_name":"california department of water resources","id":"c036faaa-033b-49b1-b3aa-8299d01608c4","name":"california department of water resources","state":"active","vocabulary_id":null}],"relationships_as_subject":[],"relationships_as_object":[]},{"accessLevel":"public","accrualPeriodicity":"irregular","author_email":null,"conformsTo":"","contact_email":"benjamin.gooding@water.ca.gov","contact_name":"Ben Gooding","creator_user_id":"be1db721-b4f5-4257-abcb-c2115ad06ee3","id":"3e17a6d8-8855-49ad-9c0b-e39ed5e68738","isopen":false,"language":"","license_title":null,"maintainer":null,"maintainer_email":null,"metadata_created":"2026-09-30T19:36:37.119085","metadata_modified":"2026-10-08T18:33:15.275695","name":"gsp-monitoring-data","notes":"The Groundwater Sustainability Plan (GSP) Monitoring dataset contains the monitoring sites and associated groundwater level, subsidence or streamflow measurements collected by Groundwater Sustainability Agencies (GSA) during implementation of their GSP. All data is submitted to the Department of Water Resources (DWR) through the Sustainable Groundwater Management Act (SGMA) Portal’s Monitoring Network Module (MNM).\r\n  \r\nThe GSP Regulations established the monitoring network criteria (23 CCR § 354.34) and the data and reporting standard for monitoring sites and measurements (23 CCR § 352.4). The data fields associated with these datasets were created by DWR to ensure that GSAs electronically submit monitoring site and measurement data which meets the GSP Regulation’s data and reporting standards. For additional information regarding GSAs, GSPs, and SGMA related monitoring, please view DWR’s SGMA Portal Resources at https://sgma.water.ca.gov/portal/.","num_resources":10,"num_tags":4,"organization":{"id":"01a60364-64d7-4a35-98ee-ead3a26785ec","name":"california-department-of-water-resources","title":"California Department of Water Resources","type":"organization","description":"Website: https://water.ca.gov/\r\n\r\nThe Department of Water Resources (DWR) is responsible for managing and protecting California’s water resources. DWR works with other agencies to benefit the State’s people and to protect, restore and enhance the natural and human environments.","image_url":"2018-12-07-183801.609480DWRLOGO4inch.jpg","created":"2026-09-30T19:02:07.434431","is_organization":true,"approval_status":"approved","state":"active"},"owner_org":"01a60364-64d7-4a35-98ee-ead3a26785ec","private":false,"rights":"No restrictions on public us