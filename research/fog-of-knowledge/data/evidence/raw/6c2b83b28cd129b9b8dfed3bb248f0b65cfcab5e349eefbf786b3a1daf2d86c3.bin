on":"","format":"CSV","hash":"e8d090e61f596de5e4b8c4554745dc72","id":"32c2cf70-9723-4245-b793-a36bc21f97aa","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.222720","mimetype":null,"mimetype_inner":null,"name":"Stream Gage Sites","package_id":"3e17a6d8-8855-49ad-9c0b-e39ed5e68738","position":4,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/536dc423-01b3-4094-bdcd-903df84f6768/resource/a7967b41-2619-4805-b7b8-f6ac0ee058c0/download/stream_gage_sites.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:36:37.123204","datastore_active":false,"description":"","format":"CSV","hash":"d8ceeed299e3dccc22a82f528ed8c78a","id":"e2c23aea-6a0e-4687-95e9-6aa0a6594791","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.222772","mimetype":null,"mimetype_inner":null,"name":"Stream Gage Data","package_id":"3e17a6d8-8855-49ad-9c0b-e39ed5e68738","position":5,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/536dc423-01b3-4094-bdcd-903df84f6768/resource/e65b8d20-5b52-4a13-9273-c0715d6715af/download/stream_gage_data.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:36:37.123205","datastore_active":false,"description":"","format":"CSV","hash":"7c649d5eb85ecbf8e27d399e6e76729e","id":"1b1d4537-5dfb-4351-85ca-3980d855072a","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.222823","mimetype":null,"mimetype_inner":null,"name":"Existing Sites","package_id":"3e17a6d8-8855-49ad-9c0b-e39ed5e68738","position":6,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/536dc423-01b3-4094-bdcd-903df84f6768/resource/52dfa922-aa85-4efe-bde9-1e1f39a17396/download/existing_sites.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:36:37.123205","datastore_active":false,"description":"This service is under development as part of ongoing enhancements to the SGMA Data Viewer and CalGW Live. Once the format is finalized, the service will be hosted at https://gis.water.ca.gov/arcgis/rest/services/.\r\n\r\nDWR makes no warranties or guarantees — either expressed or implied — as to the completeness, accuracy, or correctness of the data. DWR neither accepts nor assumes liability arising from or for any incorrect, incomplete, or misleading subject data.","format":"","hash":"","id":"88a708d5-8064-44d9-ae6a-622a7e4de548","last_modified":null,"metadata_modified":"2026-09-30T19:36:37.099368","mimetype":null,"mimetype_inner":null,"name":"GSP Monitoring Data GIS Service","package_id":"3e17a6d8-8855-49ad-9c0b-e39ed5e68738","position":7,"resource_type":null,"size":null,"state":"active","url":"https://services.arcgis.com/aa38u6OgfNoCkTJ6/arcgis/rest/services/GSP_Monitoring_Data/FeatureServer","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:36:37.123206","datastore_active":false,"description":"","format":"CSV","hash":"b0e6971bce4ea48f7474bf4024a4eb69","id":"1f705a14-6433-4718-ad67-dabf2f97371f","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.222910","mimetype":null,"mimetype_inner":null,"name":"GSP Monitoring Sites (New - Under Development)","package_id":"3e17a6d8-8855-49ad-9c0b-e39ed5e68738","position":8,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/536dc423-01b3-4094-bdcd-903df84f6768/resource/76aad0b4-f38b-469c-8e0a-38218cc73f34/download/gsp_monitoring_sites.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:36:37.123206","datastore_active":false,"description":"","format":"CSV","hash":"ae2aa88b2a158eecfbeb5dc9b49fef2b","id":"44523fc0-2eac-4dbe-b437-ec4647ff51af","last_modified":null,"metadata_modified":"2026-10-08T18:33:15.222994","mimetype":null,"mimetype_inner":null,"name":"Sustainability Management Criteria (SMC) (New - Under Development)","package_id":"3e17a6d8-8855-49ad-9c0b-e39ed5e68738","position":9,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/536dc423-01b3-4094-bdcd-903df84f6768/resource/18fa24dc-37ef-4b20-ae1b-eb021a16a635/download/gsp_monitoring_sites_smcs.csv","url_type":null}],"tags":[{"display_name":"GSP","id":"ebdf7c3a-8efe-461b-a819-538502bb4857","name":"GSP","state":"active","vocabulary_id":null},{"display_name":"Groundwater Sustainability Plan","id":"6220fd27-3e26-4027-9dae-768e88000c8a","name":"Groundwater Sustainability Plan","state":"active","vocabulary_id":null},{"display_name":"Monitoring Network","id":"5d4fa3fd-7ce9-48f3-bc0a-b32293550da2","name":"Monitoring Network","state":"active","vocabulary_id":null},{"display_name":"california department of water resources","id":"c036faaa-033b-49b1-b3aa-8299d01608c4","name":"california department of water resources","state":"active","vocabulary_id":null}],"relationships_as_subject":[],"relationships_as_object":[]},{"accessLevel":"public","accrualPeriodicity":"irregular","author_email":null,"conformsTo":"","contact_email":"benjamin.brezing@water.ca.gov","contact_name":"Ben Brezing","creator_user_id":"be1db721-b4f5-4257-abcb-c2115ad06ee3","id":"4aad347a-5764-416e-8f97-5ea6e742129e","isopen":false,"language":"","license_title":null,"maintainer":null,"maintainer_email":null,"metadata_created":"2026-09-30T19:33:17.267600","metadata_modified":"2026-10-08T18:33:16.315874","name":"dry-well-reporting-system-data","notes":"In California, water systems serving one (1) to 15 households are regulated at the county level. Counties vary in their practices, but rarely do counties collect data regularly from these systems. Even where data is collected, it is entirely voluntary. A review of well permit information suggests there are over 1 million such water systems in California.\r\n\r\nIn early 2014, a cross-agency Work Group created an easily accessible reporting system to get more systematic data on which parts of the state had households at risk of water supply shortages. The initial motivation for local water supply systems to report shortage information was to obtain statewide drought assistance. The reporting system receives ongoing reports of shortages from local, state, federal and non-governmental organizations, and tracks their status to resolution. While several counties have developed their own tracking mechanisms, this data is manually entered into the reporting system.  \r\n\r\nThe cross-agency team, led by DWR, seeks to verify and update the data submitted. However, due to the volunteer nature of the reporting and limitations on reporting agencies, collected data are undoubtedly under-representative of all shortages to have occurred. In addition, reports are received from multiple sources and there are occasionally errors and omissions that can create duplicate entries, non-household water supply reporting, and under-reporting. For example, missing information or no data for a given county does not necessarily mean that there are no household water shortages in the county, rather only that none have been reported to the State.","num_resources":2,"num_tags":3,"organization":{"id":"01a60364-64d7-4a35-98ee-ead3a26785ec","name":"california-department-of-water-resources","title":"California Department of Water Resources","type":"organization","description":"Website: https://water.ca.gov/\r\n\r\nThe Department of Water Resources (DWR) is responsible for managing and protecting California’s water resources. DWR works with other agencies to benefit the State’s people and to protect, restore and enhance the natural and human environments.","image_url":"2018-12-07-183801.609480DWRLOGO4inch.jpg","created":"2026-09-30T19:02:07.434431","is_organization":true,"approval_status":"approved","state":"active"},"owner_org":"01a60364-64d7-4a35-98ee-ead3a26785ec","private":false,"rights":"No restrictions on public use","state":"active","temporal":"","title":"Dry Well Reporting System Data","type":"dataset","url":"https://mydrywell.water.ca.gov/report/","version":null,"extras":[{"key":"guid","value":"2cf184d1-2d34-46cc-8bb0-1dec86b6caf6"},{"key":"dcat_issued","value":"2021-05-10T15:26:40.169602"},{"key":"dcat_modified","value":"2026-10-08T08:20:58.437271"},{"key":"dcat_publisher_name","value":"California Department of Water Resources"},{"key":"harvest_object_id","value":"07277c2c-21e6-4206-a511-8c2c1958ace2"},{"key":"harvest_source_id","value":"e96759e3-0e26-4ae8-b48d-5b24cfdcc9ca"},{"key":"harvest_source_title","value":"California Department of Water Resources"}],"groups":[{"description":"Themes include wildlife, fire, farmland, land use, renewable energy, geology, recreation.","display_name":"Natural Resources","id":"43dcc259-6574-4a5e-b582-b7baa904c75c","image_display_url":"https://publish.data.ca.gov/uploads/group/2020-02-06-210729.296880plant.png","name":"natural-resources","title":"Natural Resources"},{"description":"Themes include well water, water quality, wastewater, watershed, storm water, drinking water.","display_name":"Water","id":"c24c78f6-318c-4c0a-9f79-58eb4f66aed8","image_display_url":"https://publish.data.ca.gov/uploads/group/2019-08-12-225402.677293water.png","name":"water","title":"Water"}],"resources":[{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:33:17.272107","datastore_active":false,"description":"","format":"CSV","hash":"e729fcd06192f31244a1130ac7a08252","id":"235f09d1-cdc2-4a82-8049-89b9b6827400","last_modified":null,"metadata_modified":"2026-10-08T18:33:16.281213","mimetype":null,"mimetype_inner":null,"name":"Dry Well Reports","package_id":"4aad347a-5764-416e-8f97-5ea6e742129e","position":0,"resource_type":null,"size":null,"state":"active","url":"https://data.cnra.ca.gov/dataset/2cf184d1-2d34-46cc-8bb0-1dec86b6caf6/resource/e1fd9f48-a613-4567-8042-3d2e064d77c8/download/householdwatersupplyshortagereportingsystemdata.csv","url_type":null},{"cache_last_updated":null,"cache_url":null,"created":"2026-09-30T19:33:17.272110","datastore_active":false,"description":"The Dry Well Reporting System is for use by individuals not served by a public water system experiencing problems with their water supply and agencies receiving calls from those individuals.  \r\n\r\n\r\nHow is this information going to be used?  \r\nThis information is intended to inform state and local agencies on drought impacts on household water supplies. The Household Water Supply Shortage Reporting System was first created as part of our emergency response efforts to previous droughts, and we are continuing to gather information relating to shortages of household water from private well or surface water sources. Collection of data is not to be construed as application for local, state or federal assistance. Individuals interested in financial assistance will be directed towards appropriate resources.  \r\n\r\n\r\nData Collection Entails:  \r\n- Contact information for Household experiencing water shortage  \r\n- Water Shortage Problem Information and Location  \r\n- Financial Resources Available  \r\n- Well Log Data (optional)  \r\n- Reporting Agency or Local Government Information","format":"","hash":"","id":"5f65c5ac-2a39-4a4e-a868-e10b167d66c7","last_modified":null,"metadata_modified":"2026-09-30T19:33:17.253702","mimetype":null,"mimetype_inner":null,"name":"Dry Well Reporting System","package_id":"4aad347a-5764-416e-8f97-5ea6e742129e","position":1,"resource_type":null,"size":null,"state":"active","url":"https://mydrywell.water.ca.gov/report/","url_type":null}],"tags":[{"display_name":"Dry Wells","id":"1cf675dd-31d3-4504-9905-47a4f40099eb","name":"Dry Wells","state":"active","vocabulary_id":null},{"display_name":"Water Supply Shortage","id":"e34b2f8f-86c8-4a47-8a7a-68b581fe89f9","name":"Water Supply Shortage","state":"active","vocabulary_id":null},{"display_name":"california department of water resources","id":"c036faaa-033b-49b1-b3aa-8299d01608c4","name":"california department of water resources","state":"active","vocabulary_id":null}],"relationships_as_subject":[],"relationships_as_object":[]}]},"__N_SSG":true},"page":"/[org]/[dataset]","query":{"org":"@california-department-of-water-resources","dataset":"periodic-groundwater-level-measurements"},"buildId":"cUXUDYpyfNUSXSwzNOQ3Y","runtimeConfig":{"DOMAINS":["demo.dev.datopian.com","api.dev.cloud.portaljs","blob.datopian.com"]},"isFallback":false,"isExperimentalCompile":false,"gsp":true,"scriptLoader":[]}</script></body></html>