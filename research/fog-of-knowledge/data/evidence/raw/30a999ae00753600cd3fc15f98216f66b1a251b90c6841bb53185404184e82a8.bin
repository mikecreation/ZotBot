{"batchcomplete":true,"query":{"pages":[{"pageid":10806718,"ns":0,"title":"Data sharing","extract":"Data sharing denotes the dissemination of research datasets to enable access and use by other investigators. Policies governing this practice are increasingly instituted by funding agencies, academic institutions, and scholarly journals, reflecting the consensus that transparency and openness constitute foundational principles of the scientific method.","description":"Research dataset dissemination to enable access/use by investigators","descriptionsource":"local"}]}}