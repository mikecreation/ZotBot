{"batchcomplete":true,"query":{"pages":[{"pageid":1460717,"ns":0,"title":"Betweenness problem","extract":"Betweenness is an algorithmic problem in order theory about ordering a collection of items subject to constraints that some items must be placed between others. It has applications in bioinformatics and was shown to be NP-complete by Opatrný (1979).","description":"Algorithmic problem in order theory","descriptionsource":"local"}]}}