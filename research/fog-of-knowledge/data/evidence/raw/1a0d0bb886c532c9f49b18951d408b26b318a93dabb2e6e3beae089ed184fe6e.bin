{"batchcomplete":true,"query":{"pages":[{"pageid":4614488,"ns":0,"title":"Compossibility","extract":"Compossibility is a philosophical concept from Gottfried Wilhelm Leibniz. According to Leibniz, a complete individual thing (for example a person) is characterized by all its properties, and these determine its relations with other individuals.","description":"Philosophical concept","descriptionsource":"local"}]}}