{"batchcomplete":true,"query":{"pages":[{"pageid":37103476,"ns":0,"title":"Causal inference","extract":"Causal inference is the process of determining the independent, actual effect of a particular phenomenon that is a component of a larger system. The main difference between causal inference and inference of association is that causal inference analyzes the response of an effect variable when a cause of the effect variable is changed.","description":"Branch of statistics","descriptionsource":"local"}]}}