{"batchcomplete":true,"query":{"pages":[{"pageid":1364502,"ns":0,"title":"Belt (mechanical)","extract":"A belt is a loop of flexible material used to link two or more rotating shafts mechanically, most often parallel. Belts may be used as a source of motion, to transmit power efficiently or to track relative movement.","description":"Method of connecting two rotating shafts or pulleys","descriptionsource":"local"}]}}