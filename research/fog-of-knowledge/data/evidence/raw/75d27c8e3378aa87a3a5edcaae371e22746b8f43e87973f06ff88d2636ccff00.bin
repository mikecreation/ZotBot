}.gfield_required,.gform_fields .gfield_validation_message{color:#b60109}.gfield_required .gfield_required_text{font-size:90%;font-weight:400;margin-left:6px}.gfield_required .gfield_required_asterisk{margin-left:3px}.gform_fields .gfield_validation_message{align-items:center;display:flex;letter-spacing:.25px}.gform_fields .validation_message--hidden-on-empty{display:none}.gfield_validation_message:before{content:url(data:image/svg+xml;base64,);margin-right:6px}.gform_fields .gform-field-label--type-sub{margin-bottom:12px}.gform_fields input+.gform-field-label--type-sub{margin:5px 0 12px}.gform_fields .gfield-hds-multifile-uploads button,.gform_footer .gform_button.button,.gform_page_footer .gform_button.button,.gform_page_footer .gform_next_button.button,.gform_page_footer .gform_previous_button.button{background-color:#f64137;border:none;color:#fff;font-size:16px;font-weight:600;line-height:20px;padding:12px 20px;transition:background-color .2s ease-in-out}.gform_page_footer .gform_previous_button.button{background-color:unset;border:1px solid #1c67e3;color:#000;margin-right:1.5em}.gform_fields .gfield-hds-multifile-uploads button{font-size:12px;padding:6px 10px}.gform_fields .gfield-hds-multifile-uploads button:hover,.gform_footer .gform_button.button:hover,.gform_page_footer .gform_button.button:hover,.gform_page_footer .gform_next_button.button:hover,.gform_page_footer .gform_previous_button.button:hover{background-color:#b60109;cursor:pointer;transition:background-color .2s ease-in-out}.gform_page_footer .gform_previous_button.button:hover{background-color:unset}.gform_fields .gfield-hds-multifile-uploads button:focus .gform_footer .gform_button.button:focus{outline:1px dashed #b9b9bb}.gform_fields .gfield-hds-singlefile-uploads .ginput_container input::file-selector-button{background-color:#f64137;border:none;color:#fff;font-size:12px;font-weight:600;line-height:20px;padding:6px 10px;transition:background-color .2s ease-in-out}.gform_fields .gfield-hds-singlefile-uploads .ginput_container input::file-selector-button:hover{background-color:#b60109;cursor:pointer;transition:background-color .2s ease-in-out}.usa-article-content div.form-entry-content p.form-omb-approval-wrapper{margin:0}div.form-entry-content p.form-omb-approval-wrapper .form-omb-approval-label{font-size:.7rem;font-weight:700;margin-right:5px}div.form-entry-content p.form-omb-approval-wrapper .form-omb-approval-code{font-family:dm-mono,monospace;font-size:.9rem;font-style:normal;font-weight:500;letter-spacing:1px;line-height:1;text-transform:uppercase}.gf_progressbar_wrapper{margin-bottom:16px}.gf_progressbar_title{color:#2e2e32;font-size:14px;font-weight:600;margin-bottom:8px}.gf_progressbar{background-color:#e6e6e6;border-radius:4px;height:20px;overflow:hidden}.gf_progressbar_percentage{background-color:#1c67e3;border-radius:4px;height:100%;text-align:center;transition:width .3s ease}.gf_progressbar_percentage span{color:#fff;display:block;font-size:12px;font-weight:600;line-height:20px}.hds-gf-stepper{margin-bottom:24px}.hds-gf-stepper__list{display:flex;gap:4px;list-style:none;margin:0;padding:0}.hds-gf-stepper__item{display:flex;flex:1 0 0;flex-direction:column;gap:12px;min-width:0}.hds-gf-stepper__bar{background-color:#d1d1d1;display:block;height:6px;width:100%}.bg-carbon-90 .hds-gf-stepper__bar{background-color:#3d3d40}.hds-gf-stepper__item.is-complete .hds-gf-stepper__bar{background-color:#288bff}.hds-gf-stepper__item.is-active .hds-gf-stepper__bar{background-color:#1c67e3}.hds-gf-stepper__content{display:flex;flex-direction:column;gap:4px;min-width:0}.hds-gf-stepper__heading{align-items:center;color:#000;display:flex;font-family:Inter,sans-serif;font-size:16px;font-weight:400;gap:4px;letter-spacing:-.5px;line-height:20px}.bg-carbon-90 .hds-gf-stepper__heading{color:#d1d1d1}.hds-gf-stepper__item.is-active .hds-gf-stepper__heading{font-weight:600}.hds-gf-stepper__sub{color:#58585b;font-size:12px;font-weight:400;letter-spacing:.25px;line-height:16px}.hds-gf-stepper__check{fill:currentcolor;color:#47da84;flex-shrink:0;height:20px;width:20px}.hds-gf-stepper__current-step{color:#58585b;display:none;font-size:12px;font-weight:400;letter-spacing:.25px;line-height:16px;margin-top:4px}.bg-carbon-90 .hds-gf-stepper__current-step{color:#b9b9bb}.hds-single-form-embed.bg-carbon-90 .form-entry-content{margin-bottom:40px;width:100%}.bg-carbon-90 .gform_fields .ginput_container span>*,.bg-carbon-90 .gform_fields .ginput_container>*{background:transparent;color:#d1d1d1}.bg-carbon-90 .gform_fields .ginput_container input::-moz-placeholder{color:#d1d1d1}.bg-carbon-90 .gform_fields .ginput_container input::placeholder{color:#d1d1d1}.bg-carbon-90 .gform_fields .gsection_title{border-bottom:1px solid #fff}.bg-carbon-90 .gform_fields .ginput_container_date:after{content:url(data:image/svg+xml;base64,)}.bg-carbon-90 .gform_fields .ginput_container_select:after{content:url(data:image/svg+xml;base64,)}.bg-carbon-90 .gf_progressbar_title,.bg-carbon-90 .gfield--type-html,.bg-carbon-90 .gfield--type-html a,.bg-carbon-90 .gform-field-label,.bg-carbon-90 .gform_fields .gfield_description,.bg-carbon-90 .gform_fields .gsection_description,.bg-carbon-90 .gform_required_legend,.bg-carbon-90 h2{color:#d1d1d1}.bg-carbon-90 .gf_progressbar{background-color:#3d3d40}.bg-carbon-90 .hds-gf-stepper__sub{color:#b9b9bb}.gform_submission_error{font-size:revert}@media only screen and (min-width:800px){.hds-single-form-embed.bg-carbon-90{padding:2rem}.hds-single-form-embed.bg-carbon-90 .form-entry-content{margin-bottom:0}.gform_fields select{padding:0 16px}}@media only screen and (max-width:799px){.hds-gf-stepper__content{clip:rect(1px,1px,1px,1px);word-wrap:normal;clip-path:inset(50%);height:1px;overflow:hidden;position:absolute;white-space:nowrap;width:1px}.hds-gf-stepper__current-step{display:block}}

