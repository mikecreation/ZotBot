{"batchcomplete":true,"query":{"pages":[{"pageid":7168897,"ns":0,"title":"Backcasting","extract":"Backcasting is a planning method that starts with defining a desirable future and then works backwards to identify policies and programs that will connect that specified future to the present. The fundamentals of the method were outlined by John B. Robinson from the University of Waterloo in 1990.","description":"Influencing current reality from desired future state scenario","descriptionsource":"local"}]}}