{"numberOfHits":1,"results":[{"id":"GO:0007049","isObsolete":false,"name":"cell cycle","definition":{"text":"The progression of biochemical and morphological phases and events that occur in a cell during successive cell replication or nuclear replication events. Canonically, the cell cycle comprises the replication and segregation of genetic material followed by the division of the cell, but in endocycles or syncytial cells nuclear replication or nuclear division may not be followed by cell division."},"synonyms":[{"name":"cell-division cycle","type":"exact"}],"subsets":["goslim_candida","goslim_pir","goslim_plant","goslim_chembl","goslim_agr","goslim_flybase_ribbon","goslim_plant_ribbon"],"children":[{"id":"GO:0044786","relation":"part_of"},{"id":"GO:0045786","relation":"negatively_regulates"},{"id":"GO:0045787","relation":"positively_regulates"},{"id":"GO:0033260","relation":"part_of"},{"id":"GO:0000278","relation":"is_a"},{"id":"GO:0022402","relation":"part_of"},{"id":"GO:0051726","relation":"regulates"},{"id":"GO:0051321","relation":"is_a"}],"history":[{"timestamp":"2024-12-05","action":"Added","category":"XREF","text":"Reactome:R-HSA-1640170"},{"timestamp":"2024-03-21","action":"Deleted","category":"SUBSET","text":"gocheck_do_not_manually_annotate"},{"timestamp":"2024-03-21","action":"Added","category":"SUBSET","text":"goslim_plant_ribbon"},{"timestamp":"2024-03-21","action":"Added","category":"SUBSET","text":"gocheck_do_not_annotate"},{"timestamp":"2022-04-08","action":"Deleted","category":"SUBSET","text":"goslim_aspergillus"},{"timestamp":"2021-11-15","action":"Deleted","category":"SUBSET","text":"goslim_generic"},{"timestamp":"2020-02-28","action":"Deleted","category":"XREF","text":"MIPS_funcat:10.03"},{"timestamp":"2020-02-28","action":"Deleted","category":"XREF","text":"MIPS_funcat:10"},{"timestamp":"2019-05-04","action":"Added","category":"XREF","text":"MIPS_funcat:10.03"},{"timestamp":"2019-05-04","action":"Added","category":"XREF","text":"MIPS_funcat:10