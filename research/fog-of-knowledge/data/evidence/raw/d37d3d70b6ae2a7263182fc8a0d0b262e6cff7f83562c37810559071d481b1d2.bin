{"batchcomplete":true,"query":{"pages":[{"pageid":55960563,"ns":0,"title":"Autogenous welding","extract":"Autogenous welding is a form of welding in which the filler material is either supplied by melting the base material or is of identical composition. The weld may be formed entirely by melting parts of the base metal, and no additional filler rod is used.","description":"Form of welding where no additional filler material is added","descriptionsource":"local"}]}}