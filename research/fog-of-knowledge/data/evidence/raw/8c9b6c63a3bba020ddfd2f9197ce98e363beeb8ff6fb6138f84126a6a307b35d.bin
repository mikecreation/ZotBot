{"version":"6.9","hitCount":1,"request":{"queryString":"EXT_ID:42585261 AND SRC:MED","internalQuery":"EXT_ID:42585261 AND SRC:MED","resultType":"CORE","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"42585261","source":"MED","pmid":"42585261","pmcid":"PMC13485135","fullTextIdList":{"fullTextId":["PMC13485135"]},"doi":"10.1371/journal.pcbi.1013017","title":"REvolutionH-tl 2.0: A fast and robust tool for decoding evolutionary gene histories.","authorString":"Ramírez-Rafael JA, Korchmaros A, Aviña-Padilla K, López-Sánchez A, Martinez-Medina G, Hernández-Álvarez AJ, Hellmuth M, Stadler PF, Hernández-Rosales M.","authorList":{"author":[{"fullName":"Ramírez-Rafael JA","lastName":"Ramírez-Rafael","firstName":"José Antonio","initials":"JA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Genetic Engineering, Center for Research and Advanced Studies of the National Polytechnic Institute, Irapuato Unit, Irapuato, Guanajuato, Mexico."},{"affiliation":"Department of Computer Science, University of Leipzig, Leipzig, Saxony, Germany."},{"affiliation":"Max Planck Institute for Mathematics in the Sciences, Leipzig, Saxony, Germany."}]}},{"fullName":"Korchmaros A","lastName":"Korchmaros","firstName":"Annachiara","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-7334-669X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, University of Leipzig, Leipzig, Saxony, Germany."}]}},{"fullName":"Aviña-Padilla K","lastName":"Aviña-Padilla","firstName":"Katia","initials":"K","authorId":{"type":"ORCID","value":"0000-0002-6338-7930"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Genetic Engineering, Center for Research and Advanced Studies of the National Polytechnic Institute, Irapuato Unit, Irapuato, Guanajuato, Mexico."},{"affiliation":"Department of Cell Biology, Center for Research and Advanced Studies of the National Polytechnic Institute, Mexico City, Mexico."}]}},{"fullName":"López-Sánchez A","lastName":"López-Sánchez","firstName":"Alitzel","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-3545-039X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, University of Sherbrooke, Sherbrooke, Quebec, Canada."}]}},{"fullName":"Martinez-Medina G","lastName":"Martinez-Medina","firstName":"Gabriel","initials":"G","authorId":{"type":"ORCID","value":"0009-0001-6672-9449"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Genetic Engineering, Center for Research and Advanced Studies of the National Polytechnic Institute, Irapuato Unit, Irapuato, Guanajuato, Mexico."}]}},{"fullName":"Hernández-Álvarez AJ","lastName":"Hernández-Álvarez","firstName":"Alfredo J","initials":"AJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centro de Ciencias Genómicas, UNAM, Cuernavaca, Mexico."}]}},{"fullName":"Hellmuth M","lastName":"Hellmuth","firstName":"Marc","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-1620-5508"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Mathematics, Stockholm University, Stockholm, Sweden."}]}},{"fullName":"Stadler PF","lastName":"Stadler","firstName":"Peter F","initials":"PF","authorId":{"type":"ORCID","value":"0000-0002-5016-5191"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, University of Leipzig, Leipzig, Saxony, Germany."},{"affiliation":"Max Planck Institute for Mathematics in the Sciences, Leipzig, Saxony, Germany."},{"affiliation":"Department of Theoretical Chemistry, University of Vienna, Vienna, Austria."},{"affiliation":"Santa Fe Institute, Santa Fe, New Mexico, United States of America."},{"affiliation":"Facultad de Ciencias, Universidad Nacional de Colombia, Bogotá, Colombia."}]}},{"fullName":"Hernández-Rosales M","lastName":"Hernández-Rosales","firstName":"Maribel","initials":"M","authorId":{"type":"ORCID","value":"0000-0003-1878-1223"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Genetic Engineering, Center for Research and Advanced Studies of the National Polytechnic Institute, Irapuato Unit, Irapuato, Guanajuato, Mexico."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-1620-5508"},{"type":"ORCID","value":"0000-0002-3545-039X"},{"type":"ORCID","value":"0000-0002-5016-5191"},{"type":"ORCID","value":"0000-0002-6338-7930"},{"type":"ORCID","value":"0000-0002-7334-669X"},{"type":"ORCID","value":"0000-0003-1878-1223"},{"type":"ORCID","value":"0009-0001-6672-9449"}]},"journalInfo":{"issue":"8","volume":"22","journalIssueId":4237557,"dateOfPublication":"2026 Aug","monthOfPublication":8,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"PLoS Comput Biol","title":"PLoS computational biology","essn":"1553-7358","issn":"1553-734X","isoabbreviation":"PLoS Comput Biol","nlmid":"101238922"},"printPublicationDate":"2026-08-01"},"pubYear":"2026","pageInfo":"e1013017","abstractText":"REvolutionH-tl is a fast, scalable, and integrated software platform for inferring orthology relationships, gene trees, species trees, and reconciled evolutionary scenarios directly from sequence data. Built upon the formal framework of best match graphs (BMGs), REvolutionH-tl predicts orthogroups and orthologous gene pairs with high accuracy, requiring neither precomputed trees nor multiple external tools. The software reconstructs event-labeled gene and species trees, seamlessly integrating reconciliation to produce fast, accurate, and biologically insightful evolutionary scenarios. Through extensive benchmarking on synthetic datasets with known ground truth, REvolutionH-tl outperforms or matches the accuracy of established tools such as OrthoFinder, Proteinortho, RAxML, GeneRax, and RANGER-DTL, while achieving significantly lower runtimes. A key innovation of REvolutionH-tl is its built-in support for detailed, publication-ready visualizations, which allow users to explore genome evolution dynamics, orthogroup composition, and reconciliation results with clarity and ease. These visual features position REvolutionH-tl as the first platform of its kind to combine analytical precision with intuitive interpretability. The software is open-source, cross-platform, and freely available at https://pypi.org/project/revolutionhtl/, providing a robust solution for large-scale evolutionary analyses in comparative genomics.","affiliation":"Department of Genetic Engineering, Center for Research and Advanced Studies of the National Polytechnic Institute, Irapuato Unit, Irapuato, Guanajuato, Mexico.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"Max Planck Institute","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"Y","descriptorName":"Computational Biology","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"N","descriptorName":"Genomics","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"Y","descriptorName":"Evolution, Molecular"},{"majorTopic_YN":"N","descriptorName":"Phylogeny"},{"majorTopic_YN":"N","descriptorName":"Algorithms"},{"majorTopic_YN":"N","descriptorName":"Models, Genetic"},{"majorTopic_YN":"Y","descriptorName":"Software"},{"majorTopic_YN":"N","descriptorName":"Databases, Genetic"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1371/journal.pcbi.1013017"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13485135"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13485135?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-08-18","dateOfCreation":"2026-08-12","dateOfRevision":"2026-09-17","electronicPublicationDate":"2026-08-12","firstPublicationDate":"2026-08-12","firstIndexDate":"2026-08-15","fullTextReceivedDate":"2026-09-09","hasEvaluations":"N"}]}}