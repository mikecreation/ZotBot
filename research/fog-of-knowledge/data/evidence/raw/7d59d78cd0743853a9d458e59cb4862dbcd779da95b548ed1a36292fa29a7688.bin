{"batchcomplete":true,"query":{"pages":[{"pageid":972005,"ns":0,"title":"Autofrettage","extract":"Autofrettage is a work-hardening  process in which a thick-walled pressure vessel is subjected to enormous pressure, causing internal portions of the part to yield plastically, resulting in internal compressive residual stresses once the pressure is released.","description":"Process to increase pressure-carrying capacity","descriptionsource":"local"}]}}