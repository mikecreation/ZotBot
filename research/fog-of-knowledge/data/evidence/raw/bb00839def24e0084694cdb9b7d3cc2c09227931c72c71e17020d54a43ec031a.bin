                <!-- Scroll behavior -->
                <script  type="application/javascript" defer>
                    let lastKnownScrollPosition = 0;
                    let isFiring = false;
                    let throttle_threshhold = 30;
                    let offset = 10;
                    let scrollDifference = 0;
                    let offset_of_toc = document.getElementById("toc").offsetHeight;

                    function action(e) {
                        if (document.getElementById("toc").hidden === false){
                            document.getElementById("toc").hidden = true;
                            document.getElementById("toc-button").setAttribute("aria-expanded", "false");                        
                    }
                    }

                    document.addEventListener('scroll', function(e) {     
                        
                        if (isFiring === false){
                            isFiring = true;
                            scrollDifference = window.scrollY - lastKnownScrollPosition;
                            if (scrollDifference > throttle_threshhold){
                                scrollDifference = scrollDifference - offset_of_toc;
                            }
                            /* has scrolled down */
                            if (scrollDifference > 0){
                                if (scrollDifference >= throttle_threshhold){
                                    action(e);
                                }
                            }
                            /* has scrolled up */
                            else if (scrollDifference < 0){
                                if (Math.abs(scrollDifference) >= throttle_threshhold){
                                    action(e);
                                }
                            }
                            lastKnownScrollPosition = window.scrollY;
                            scrollDifference = 0;
                            isFiring = false;
                        }
                    });

                </script>
            
            
            
 

           

