                                    // container for cloned header which will stick to the top
                                    var fixed_header_wrapper = table_panels[i].querySelector('.fixed-header-wrapper');
                                    var fixed_header_div = fixed_header_wrapper.querySelector('.fixed-header');
                                    
                                    // create cloned header
                                    var table_cloned = table_pdf.cloneNode(true);
                                    table_cloned.removeChild(table_cloned.getElementsByTagName('tbody')[0]);
                                    table_cloned.style['margin-bottom'] = '0rem';
    
                                    // attach cloned header to container
                                    fixed_header_div.appendChild(table_cloned);
                                    // set width of container to width of table (will match scrollbars)
                                    fixed_header_div.style.width = table_pdf.offsetWidth + 'px';
    
                                    // hide original header
                                    original_thead.style['visibility'] = 'collapse';
    
                                    // set original header aria-hidden
                                    original_thead.ariaHidden = true;
    
                                    // go through the th's in the new fixed header, modify their ID to enforce uniqueness, and set aria-hidden to prevent further problems.
                                    Array.from(table_cloned.getElementsByTagName('th')).forEach((el) => {
                                        el.id = el.id + "_COLLAPSED";
                                        el.ariaHidden = true;
                                        //console.log("Modified ID of " + el.id.toString());
                                    });
    
                                    // set width of cloned header to match width of table
                                    table_cloned.style.width = 'inherit';
    
                                    // prevents vertical scrollbar from appearing when header is collapsed
                                    table_scroll_container.style['overflow-y'] = 'hidden';
    
                                    original_thead.style.display = 'none;';
    
                                    // set event listeners to synchronize scrolling from top and bottom
                                    if (fixed_header_wrapper != null && table_scroll_container != null){
                                        // sync top scroll bar to bottom
                                        fixed_header_wrapper.onscroll = function(e) {
                                            e.target.parentElement.querySelector('.table-scroll-container').scrollLeft = e.target.scrollLeft;
                                        };
                                        // sync bottom scroll bar to top
                                        table_scroll_container.onscroll = function(e) {
                                            e.target.parentElement.querySelector('.fixed-header-wrapper').scrollLeft = e.target.scrollLeft;
                                        };
                                    }
                                    
                                    postLoadActionSummary.push("Completed Fixed Header operation");
    
                                }
                            }
                        }catch(error){
                            console.log("problem with table id: " + id);
                            console.log(error);
                            reject(error);
                        }
                    }
                }
    
               
                
                
                
                let modal_button = document.getElementById("modal-button");
                modal_button.addEventListener("click", (event) => {
                    // console.log(modal_has_been_opened);
    
                    if (modal_has_been_opened === false) {
                        const p = new Promise((resolve, reject) => {
                        
                            let loading_indicator = document.getElementById("modal_list_loading_indicator");
                            loading_indicator.hidden = false;
    
    
                            let data = [{"citing_doi": "10.1007/s10098-026-03578-6", "type": "journal_article"}, {"citing_doi": "10.5194/gmd-18-1737-2025", "type": "journal_article"}, {"citing_doi": "10.1016/j.agwat.2026.110138", "type": "journal_article"}, {"citing_doi": "10.1016/j.jhydrol.2025.133091", "type": "journal_article"}, {"citing_doi": "10.1016/j.nexus.2025.100541", "type": "journal_article"}, {"citing_doi": "10.1016/j.jhydrol.2026.136272", "type": "journal_article"}, {"citing_doi": "10.1088/3033-4942/ae4feb", "type": "journal_article"}, {"citing_doi": "10.2489/jswc.2024.1001A", "type": "journal_article"}, {"citing_doi": "10.3390/conservation6030104", "type": "journal_article"}, {"citing_doi": "10.3133/sir20265009", "type": "report_paper_content"}, {"citing_doi": "10.1016/j.scitotenv.2026.181852", "type": "journal_article"}, {"citing_doi": "10.1007/s10040-026-03063-w", "type": "journal_article"}, {"citing_doi": "10.1007/s10661-026-15061-2", "type": "journal_article"}, {"citing_doi": "10.1016/j.agwat.2025.109370", "type": "journal_article"}];
                            // console.log(data);
                            fetch('/get_citation_data', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json', 
                                },
                                body: JSON.stringify(data), 
                            })
                            .then(response => {
                                
                                if (!response.ok) throw new Error('Network response was not ok');
                                return response.json(); 
                            })
                            .then(data => {  
                                let data_response = data.response;
                                let modal_list = document.getElementById('modal_list');
                                
                                for (let i = 0; i < data_response.length; i++){
                                    
                                    let newDiv = document.createElement("div");
    
                                    newDiv.textContent = data_response[i].formatted_citation;
                                    newDiv.className = "citation-modal-list-element";
                                    
                                    modal_list.appendChild(newDiv);
                                }
                                
                                modal_has_been_opened = true;
                                loading_indicator.hidden = true;
                                
                            })
                            .catch(error => console.error('Fetch error:', error))
                            .finally(() => {});
    
                        }).then((event) => {
                            
                            resolve();
                        }).catch((error) => {
                            console.error(error.message); 
                        }).finally(() => {});
                    }
                });
                
                
                var event = new CustomEvent("pubswh-page-loaded", 
                { 
                    
                    "detail": {
                        "message": "post-load actions completed.",
                        "summary": postLoadActionSummary
                         }
                });
                resolve(event);
                
                
            });
        }).then((event) => {
            document.dispatchEvent(event);
        })
        .catch((error) => {
            console.error(error.message); 
        })
        .finally(() => {
            
        });
    
    </script>


