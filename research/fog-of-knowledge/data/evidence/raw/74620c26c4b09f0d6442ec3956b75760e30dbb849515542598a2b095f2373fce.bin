<TD VALIGN=top><A HREF="AATHierarchy?find=&logic=&note=&page=1&subjectid=300145966"><IMG SRC='/global/images/global_hierarchy.gif' BORDER=0 ALT="Hierarchy of religious concepts" WIDTH=13 HEIGHT=14></A><BR><IMG SRC='/global/images/ghost.gif' WIDTH=1 HEIGHT=3></TD>
