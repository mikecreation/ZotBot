ul#menu-science-italian,
ul#menu-science-korean,
ul#menu-science-portuguese,
ul#menu-science-spanish {
  background-color: #f8f8f8;
	padding: 8%; }

#nav_menu-17 {
	background-color: #f8f8f8;
	padding: 8%; }

#nav_menu-17 h3 {
	margin-bottom: 0; }

/* PAGES */

h1.entry-title {
	font-size: 4.8rem;
  margin-bottom: 6%;
  text-align: left; }

div.photo-summary img {
  margin-bottom: 4%; }

/* FULL-WIDTH */

.full-width .content {
  padding-right: 0px;
	font-size: 1.8rem;
	font-family: open-sans, sans-serif; }

.full-width h1.entry-title {
  padding-left: 0px; } 

/* MISC */

.institute {
  font-weight: bold;
  color: #099; }

hr {
  border-bottom: 1px solid #ddd; }

/* EXTERNAL LINKS */

a.ext:after, .ext a:after, h3.ext:after {
  content: '';
  display: inline-block;
  /* float: right; */
  margin-left: 10px;
  width: 12px;
  height: 12px;
  background-image: url(/wp-content/uploads/sites/8/2018/06/ext-1.png);
  background-size: 24px 12px;
  background-repeat: no-repeat;
  background-position: -12px 0; } 

a.ext.white:after, 
.ext.white a:after,
a.ext:hover:after, 
.ext a:hover:after {
  background-position:0 0; }

.home-middle .ext:after,
.entry-title-link.ext:after {
  content: '';
  display: inline-block;
  width: 12px;
  height: 12px;
  background-image: url(images/ext.png);
  background-size:24px 12px;
  background-repeat:no-repeat;
  background-position:-12px 0;
  margin-left:8px;
  float:none; }

/* ---- Flex Gallery ---- */

.children {
  display: flex;
  flex-flow: row wrap;
  justify-content: space-around;
  min-height: 200px; }

.child {
  flex: 0 0 auto;
  list-style-type: none;
  width: 30%;
  padding: 25px;
  border: solid 1px #ddd;
 	font-size: 1.6rem; }

.child a {
  background-color: #fff;
  display: block;
  padding: 0;
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center top;
  color: #333333;
  text-decoration: none;
  text-align: center;
  position: relative; }

.child h3 {
  text-decoration: none;
  text-align: center;
	font-size: 2.3rem;
	font-weight: 600;
	/* letter-spacing: 3px; */
	color: #fff;
  line-height: 0;
  margin-bottom: 0; }

/* ---- FOOTER ---- */

.social-links img {
  height: 40px;
  padding-right: 20px; }

a.footer-button {
  color: white;
  padding: 16px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 16px;
  margin: 4px 30px 30px 0px;
  cursor: pointer;
  border-radius: 8px;
  border: 1px solid #fff; }

.site-footer {
  display: none; }

.footer-widgets a {
  text-decoration: none;
  display: inline; }

footer .footer-social {
  margin: 36px 0 24px 0;
  padding: 0;
  font-size: 30px;
  text-align: center; }

.copyright {
  font-size: 70%;
  padding-top: 20px; }

.wp-caption-text {
	margin-top: 8px; }</style></head>
