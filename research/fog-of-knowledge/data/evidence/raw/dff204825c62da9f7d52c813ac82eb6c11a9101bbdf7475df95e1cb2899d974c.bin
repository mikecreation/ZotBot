</script><style type="text/css">.site-title a { background: url(https://www.desi.lbl.gov/wp-content/uploads/sites/8/2020/01/DESI-logo-2.1.png) no-repeat !important; }</style>
<link rel="alternate" href="https://www.desi.lbl.gov/the-desi-science-mission/" hreflang="en-us" />
<link rel="alternate" href="https://www.desi.lbl.gov/mission-scientifique-desi/" hreflang="fr-fr" />
<link rel="alternate" href="https://www.desi.lbl.gov/the-desi-science-mission/ciencia-con-desi/" hreflang="es-es" /><style id="sccss">/* Enter Your Custom CSS Here */

.site-title {
  margin-bottom: 6px;
  margin-top: 10px; }

.entry-title {
  margin-bottom: 0px; }

.genesis-nav-menu a {
  font-size: 1.4rem;
  font-weight: 500; }

#text-12 #twitter-widget-0 {  
  width: 60% !important; }

@media only screen and (max-width: 800px) {
#text-12 #twitter-widget-0 {  
  width: 100% !important; } }

body > div {
  font-size: 1.8rem;
  line-height: 150%; }

body {
  color: #333; }
  
p.lead {
  font-size: 125%;
  line-height: 150%; }

.entry-title h2 {
		padding: 32px 0 0 0; }

h5 {
  font-weight: 600; }

.wp-caption-text {
  font-style: italic; }

/* POSTS */

.category-announcements h2.entry-title {
	font-weight: 700;
	font-size: 150%;
  line-height: 1.0;
  margin-bottom: 3%; }

.entry-meta {
  display: none; } 

.h4.entry-title .entry-title {
  font-size: 26px;
  font-weight: 700;
  color: #666;
  padding-left: 200px; 
	margin: 3% 0 3% 0; }

.post-template-default h1.entry-title {
  font-size: 2.6rem;
  font-weight: 600;
  padding-left: 0px;
  color: rgb(0, 160, 178);
  margin: 3% 0px; }

/* VIDEOS */

.videos-toprule {
	margin-bottom: 40px;
	margin-top: -20px; }

.videos-container {
	display: grid;
  grid-gap: 20px;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto; }

.videos-container a,
.videos-container iframe {
  height: auto;
  width: 300px;
  object-fit: cover; }

/* USER GALLERY */

@media only screen and (max-width: 600px) { 
  .page-id-666 .gallery-item {
  width: 100%; } } 
		
.page-id-666 #genesis-content, .page-id-126 #genesis-content {
  padding: 0; }

/* GALLERY */

@media only screen and (max-width: 800px) {
  .full-width h1.entry-title {
  padding-left: 0 !important;
	text-align: center; } } 

.page-id-125 h1.entry-title {
	text-align: left; }

.page-id-125 #genesis-content, .page-id-126 #genesis-content {
  padding: 0; } 

.page-id-126 h4 {
	padding-bottom: 14px; } 

.gallery {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  justify-content: space-between; }

.gallery a {
  flex-grow: 1;
  flex-basis: auto;
  max-width: 300px;
  margin: 5px; }

.gallery img {
  height: 100%;
  width: 100%; }

.gallery-text {
  padding-left: 0px;
  line-height: 250%; }
.page-id-125 h1 {
	text-align: center; }		

.wp-caption-text {
  font-size: 1.5rem;
  line-height: 1.2;
  padding-bottom: 5%; }

.images-container {
  display: grid;
  grid-gap: 20px;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto; } 

.images-container img {
  height: 225px;
  width: 100%;
  object-fit: cover; }

/* GALLERY Other Images */

.page-id-666 main#genesis-content.content, .page-id-670 main#genesis-content.content {
	padding: 0; }  

#other-videos-container {
  display: grid;
  grid-gap: 15px;
  grid-auto-rows: 280px; } 

#other-videos-container a {
  height: 250px;
  width: 100%;
  object-fit: cover; }

/* VENDORS */

.vendors-container {
  display: grid;
  grid-gap: 0px;
  grid-auto-rows: 116px; } 

.vendors-container img {
  height: 116px;
  width: 100%;
  object-fit: contain; }

/* HOMEPAGE */

/* -- latest blog posts -- */

#featured-post-5 {
	background-color: #f5f5f5;
	padding: 0 0 0 0;
	text-align: left;
	font-size: 90%;
  line-height: 1.25; }

#featured-post-5 article {
	margin-bottom: 0; }

#featured-post-5 h4 {
	font-size: 2.6rem;
	font-weight: 600;
	padding-top: 0; }

/* -- */

#media_video-3 {
  background-color: #f5f5f5;
	padding: 0px 0px 0px 0px;
}

@media only screen and (max-width: 800px) { .one-half {
  margin: 0;
  width: 100%; } }

.home h1.entry-title {
  display: none;
  margin-bottom: 0; }

.home h2.entry-title {
  display: none;
  margin-bottom: 0; }

.entry-header::after {
  display: block;
  margin: 0 auto 0px;
  padding-bottom: 0px;
  width: 10%;
  border-bottom: none; }

#text-6 .textwidget {
  padding-bottom: 5rem; }

.home-section-2 {
  background-color: #f5f5f5; }

#text-13 .widget-wrap a {
  font-weight: 600;
  color: #00A0B2; }

#text-13 .widget-wrap {
  font-size: 2.6rem;
  text-align: left;
  line-height: 150%;
  color: #999; }

/* ---- HOME Highlights ---- */

#highlights {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  justify-content: center;
  margin-top: -80px;
	padding-bottom: 0%; }

#highlights a {
  flex-grow: 1;
  flex-basis: 255px;
  max-width: 300px;
  margin: 10px; }

#highlights img {
  width: 100%; }

#highlights h3 {
  font-size: 2.6rem;
  font-weight: 600; }

.home-even .wrap, .home-odd .wrap {
  max-width: 980px;
  padding-left: 20px;
  padding-right: 20px; }

p.more-from-category {
  display: none; }

.one-half {
  padding: 3%;
  background: black; /* For browsers that do not support gradients */
  background: linear-gradient(to bottom, rgba(0,0,0,.1), rgba(0,0,0,.8), rgba(0,0,0,.3)); /* Standard syntax (must be last) */ }

.two-sixths {
  padding: 3%;
	background: black; /* For browsers that do not support gradients */
  background: linear-gradient(to bottom, rgba(0,0,0,.1), rgba(0,0,0,.8), rgba(0,0,0,.3)); /* Standard syntax (must be last) */ }

.one-sixth {
  padding: 3%;
  background: black; /* For browsers that do not support gradients */
  background: linear-gradient(to bottom, rgba(0,0,0,.1), rgba(0,0,0,.8), rgba(0,0,0,.3)); /* Standard syntax (must be last) */ }

.home-even.home-section-4.widget-area {
  background-color: #f8f8f8; 
	margin-top: 0;
	padding-top: 40px; }

.home h2 {
  font-size: 3.5rem; }

.home-section-1 p {
  font-size: 2.0rem; }

.home-section-2 h3.widgettitle.widget-title {
  display: none; }

.home-section-2 h1 {
  font-size: 4.0rem; }

.home-section-2.widget-area {
  margin-bottom: -60pt; }

/* ---- HOME News ---- */

.home-section-4.widget-area {
	background-color: #f5f5f5;
	margin-top: 2%;
  margin-bottom: -100pt; }

.home-section-4 h3.widgettitle.widget-title {
	font-size: 4.0rem;
  margin-bottom: 30pt; }

.home-section-4 h4 {
  margin-top: -30pt;
  margin-bottom: -30pt;
	font-size: 2.0rem; }

/* ---- HOME Sponsors ---- */

#custom_html-6 > div {
	display: flex; } 

ul.sponsor {
  display: flex;
  flex-wrap: wrap;
  list-style-type: none;
	align-items: center;
	justify-content: space-around; }

li.sponsor-item {
	flex: 0 0 35%;
	margin: 20px;
	list-style-type: none; }

li.sponsor-page-item {
	flex: 0 0 45%;
	margin: 12px;
  list-style-type: none; }

.entry-content ul > li.sponsor-item {
  list-style-type: none; }

.entry-content ul > li.sponsor-page-item {
  list-style-type: none; }

@media only screen and (max-width: 800px) {
  ul.sponsor {
  flex-direction: column;
  flex-wrap: wrap;
  flex: 0 1 180px;
  align-items: center;
	max-width: 350px }
  .post-102 .entry-content p {
    text-align: center; }		
  li.sponsor-item {
		margin: 30px; } } 

#custom_html-6 h3 {
	color: #999;
	padding-bottom: 20px; }

#text-9 h3 {
  font-size: 3.3rem;
  color: #999; }
  
/* CATEGORY -- ARCHIVE */

.category h2 {
	font-size: 18px; }

.category article {
	margin-bottom: auto }

.category div.site-inner { 
  margin-bottom: 10%; }

.category #genesis-sidebar-primary.sidebar.sidebar-primary.widget-area {
	margin-top: 160px; }

.category-meet-a-desi-member h2 {
	font-size: 26px;
	font-weight: 700;
	padding-top: 20px;
	border-top: 2px solid #dedede; }

.entry-header, .entry-title a { 
  color: #00a0af; 
  text-align: left;
	padding-bottom: 1%;
	font-weight: 600;
  font-size: 2.6rem;}

.archive #genesis-sidebar-primary { 
  background-color: #f8f8f8;
  padding: 0px;
  margin-top: 15%; }

.archive #genesis-sidebar-primary h3.widget-title { 
  font-size: 2rem;
  font-weight: 500;
  padding-bottom: 10px; }

.archive #genesis-sidebar-primary h4.entry-title {
  font-size: 3rem;
  color: #00a0af;
	margin-bottom: 0; }

.archive .sidebar .entry-title a {
  font-size: 2rem;
  color: #00a0af;
	margin-bottom: 0; }
 
/* ARCHIVE PAGES */

.archive-description, .author-box {
  border-bottom: none;
  border-top: none; }

.archive-title {
  font-size: 4.667rem;
  color: #333;
  font-weight: 500;
  line-height: 1;
  margin-bottom: 0;
  text-align: left;  }

.archive-description, .author-box {
  margin-bottom: 30px; }

/* SIDEBAR */

.sidebar li {
  font-family: open-sans, sans-serif;
  font-size: 100%;
  line-height: 1.25;
  margin-bottom: 5%}

.sidebar a:visited { 
  color: #999; }

ul#menu-blog,
ul#menu-blog-spanish,
ul#menu-collaboration,
ul#menu-education-outreach,
ul#menu-for-scientists,
ul#menu-gallery,
ul#menu-instrument,
ul#menu-instrument-catalan,
ul#menu-instrument-italian,
ul#menu-instrument-spanish,
ul#menu-meet-a-member,
ul#menu-meet-a-member-spanish,
ul#menu-press,
ul#menu-science,
ul#menu-science-catalan,
ul#menu-science-chinese,
ul#menu-science-english,
ul#menu-science-french,
