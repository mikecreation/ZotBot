  <meta name="description" content="Abstract page for arXiv paper 2112.06861: Tests of General Relativity with GWTC-3"><meta property="og:type" content="website" />
<meta property="og:site_name" content="arXiv.org" />
<meta property="og:title" content="Tests of General Relativity with GWTC-3" />
<meta property="og:url" content="https://arxiv.org/abs/2112.06861v3" />
<meta property="og:image" content="/static/browse/0.3.4/images/arxiv-logo-fb.png" />
<meta property="og:image:secure_url" content="/static/browse/0.3.4/images/arxiv-logo-fb.png" />
