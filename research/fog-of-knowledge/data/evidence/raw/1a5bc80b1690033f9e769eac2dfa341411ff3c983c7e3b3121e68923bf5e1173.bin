{"numberOfHits":1,"results":[{"id":"GO:0005576","isObsolete":false,"name":"extracellular region","definition":{"text":"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite."},"comment":"Note that this term is intended to annotate gene products that are not attached to the cell surface. For gene products at the cell surface, consider annotating to external side of plasma membrane ; GO:0009897.","synonyms":[{"name":"extracellular","type":"exact"}],"replaces":[{"id":"GO:0004624","type":"consider"},{"id":"GO:0004625","type":"consider"},{"id":"GO:0008530","type":"consider"},{"id":"GO:0019845","type":"consider"},{"id":"GO:0044421","type":"consider"},{"id":"GO:0005615","type":"replaced_by"}],"subsets":["goslim_candida","goslim_generic","goslim_pir","goslim_plant","goslim_yeast","goslim_prokaryote","goslim_chembl","goslim_metagenomics","goslim_mouse","goslim_agr","goslim_flybase_ribbon","goslim_drosophila","goslim_prokaryote_ribbon","goslim_plant_ribbon","goslim_euk_cellular_processes_ribbon"],"children":[{"id":"GO:0030312","relation":"part_of"},{"id":"GO:0043264","relation":"part_of"},{"id":"GO:0043230","relation":"part_of"},{"id":"GO:0072562","relation":"part_of"},{"id":"GO:0035182","relation":"part_of"},{"id":"GO:0035183","relation":"part_of"},{"id":"GO:0043245","relation":"part_of"},{"id":"GO:0065010","relation":"part_of"},{"id":"GO:0043083","relation":"part_of"},{"id":"GO:0006860","relation":"occurs_in"},{"id":"GO:0042597","relation":"part_of"},{"id":"GO:0098595","relation":"part_of"},{"id":"GO:1903561","relation":"part_of"},{"id":"GO:0140392","relation":"part_of"},{"id":"GO:0006858","relation":"occurs_in"},{"id":"GO:0070701","relation":"part_of"},{"id":"GO:0036117","relation":"part_of"},{"id":"GO:0048046","relation":"part_of"},{"id":"GO:1900116","relation":"occur