{"batchcomplete":true,"query":{"pages":[{"pageid":23666,"ns":0,"title":"Prime number","extract":"A prime number (or a prime) is a natural number greater than 1 that is not a product of two smaller natural numbers. A natural number greater than 1 that is not prime is called a composite number.","description":"Number divisible only by 1 and itself","descriptionsource":"local"}]}}