{"batchcomplete":true,"query":{"pages":[{"pageid":47032561,"ns":0,"title":"Castellated beam","extract":"A castellated beam is a beam style where an I-beam is subjected to a longitudinal cut along its web following a specific pattern.\nThe purpose is to divide and reassemble the beam with a deeper web by taking advantage of the cutting pattern.","description":"Construction element","descriptionsource":"local"}]}}