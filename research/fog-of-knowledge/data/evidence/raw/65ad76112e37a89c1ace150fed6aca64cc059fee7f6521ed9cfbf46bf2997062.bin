{"batchcomplete":true,"query":{"pages":[{"pageid":21527,"ns":0,"title":"Number theory","extract":"Number theory is a branch of mathematics devoted primarily to the study of the integers and arithmetic functions. Number theorists study prime numbers as well as the properties of mathematical objects constructed from integers (for example, rational numbers), or defined as generalizations of the integers (for example, algebraic integers).","description":"Branch of pure mathematics","descriptionsource":"local"}]}}