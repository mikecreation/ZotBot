    <script>
$(function () {
    $('#cite-bottom-copy, #cite-button-copy').click(function () {
        var range = document.createRange()
        range.selectNode($(this).parent().find('.tab-pane.active').get(0))
        window.getSelection().removeAllRanges()
        window.getSelection().addRange(range)
        document.execCommand('copy')
        window.getSelection().removeAllRanges()
    })

    $('#cite-button').click(function () {
        $('#cite-menu').toggle()
    })

    $('#cite-menu-close').click(function () {
        $('#cite-menu').hide()
    })

    $(window).scroll(function() {
        var viewTop = $(window).scrollTop()
        var viewBottom = viewTop + $(window).height()
        var elementTop = $('#cite').offset().top
        var elementBottom = elementTop + $('#cite').height()

        if ((elementBottom - 20 < viewBottom) && (elementTop + 20 > viewTop)) {
            $('#cite-button').hide()
            $('#cite-menu').hide()
        } else {
            $('#cite-button').show()
        }
    })

    $(window).scroll()
})
</script>
