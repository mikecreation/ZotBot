{"batchcomplete":true,"query":{"pages":[{"pageid":55539147,"ns":0,"title":"Boolean differential calculus","extract":"Boolean differential calculus (BDC) (German: Boolescher Differentialkalkül (BDK)) is a subject field of Boolean algebra discussing changes of Boolean variables and Boolean functions.\nBoolean differential calculus concepts are analogous to those of classical differential calculus, notably studying the changes in functions and variables with respect to each other.","description":"Subject field of Boolean algebra discussing changes of Boolean variables and functions","descriptionsource":"local"}]}}