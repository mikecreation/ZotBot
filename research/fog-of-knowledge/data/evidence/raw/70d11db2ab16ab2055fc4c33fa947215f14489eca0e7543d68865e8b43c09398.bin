{"batchcomplete":true,"query":{"pages":[{"pageid":29637793,"ns":0,"title":"Aerospace materials","extract":"Aerospace materials are materials, frequently metal alloys, that have either been developed for, or have come to prominence through their use for aerospace purposes.\nThese uses often require exceptional performance, strength or heat resistance, even at the cost of considerable expense in their production or machining.","description":"Materials used for aerospace purposes","descriptionsource":"local"}]}}