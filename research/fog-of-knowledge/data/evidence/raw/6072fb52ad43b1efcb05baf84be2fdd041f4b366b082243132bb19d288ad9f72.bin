{"batchcomplete":true,"query":{"pages":[{"pageid":14225987,"ns":0,"title":"Local skepticism","extract":"Local skepticism is the view that one cannot possess knowledge in some particular domain. It contrasts with global skepticism (also known as absolute skepticism or universal skepticism), the view that one cannot know anything at all.","description":"View that one cannot possess knowledge in some particular domain","descriptionsource":"local"}]}}