{"batchcomplete":true,"query":{"pages":[{"pageid":52094170,"ns":0,"title":"Elastic and inelastic collisions apparatus","extract":"The elastic and inelastic collisions apparatus is a large apparatus to study elastic and inelastic collisions.\nIt consists of a large frame carrying two beams from which two rows of six and two wooden balls, respectively, are suspended from pairs of strings.","description":"18th-century experimental apparatus demonstrating elastic and inelastic collisions","descriptionsource":"local"}]}}