                            >H02.403.720.500.300</a></dd>
                    
                        <dd><a id="treeNumber_6" onclick=
                               "switchTab([ 'trees', 'treesTabContent' ])"
                            >N06.850.520.470</a></dd>
                    

        <dt>Unique ID</dt><dd>D017720</dd>

        <dt>RDF Unique Identifier</dt>
        <dd><a href="https://id.nlm.nih.gov/mesh/D017720.html">
            http://id.nlm.nih.gov/mesh/D017720
        </a></dd>

        <span id="annotation">
            <dt>Annotation</dt><dd>the discipline; also used for epidemiologic application of molecular biology (NIM, no qualifiers); prefer specific epidemiologic concept & specific molecular or genetic concept (IM) coordinated with main headings <a id='epidemiol' class='textLink_epidemiol' href='/record/ui?ui=Q000453'>/&zwnj;epidemiol</a> (IM) & <a id='genet' class='textLink_genet' href='/record/ui?ui=Q000235'>/&zwnj;genet</a> (IM), as "molecular epidemiology of rabies virus in France" = <a href="/record/ui?ui=D011820" class="textLink_RABIESVIRUS">RABIES VIRUS</a> <a id='genet' class='textLink_genet' href='/record/ui?ui=Q000235'>/&zwnj;genet</a> (IM) + <a href="/record/ui?ui=D012367" class="textLink_RNAVIRAL">RNA, VIRAL</a> <a id='genet' class='textLink_genet' href='/record/ui?ui=Q000235'>/&zwnj;genet</a> (NIM) (molecular aspect from text) + <a href="/record/ui?ui=D011818" class="textLink_RABIES">RABIES</a> <a id='epidemiol' class='textLink_epidemiol' href='/record/ui?ui=Q000453'>/&zwnj;epidemiol</a> (IM) (epidemiologic aspect from text) + <a href="/record/ui?ui=D005602" class="textLink_FRANCE">FRANCE</a> <a id='epidemiol' class='textLink_epidemiol' href='/record/ui?ui=Q000453'>/&zwnj;epidemiol</a> (NIM)</dd>
        </span>
                <span id="scopeNote">
                    <dt>Scope Note</dt><dd>The application of molecular biology to the answering of epidemiological questions. The examination of patterns of changes in <a href="/record/ui?ui=D004247" class="textLink_DNA">DNA</a> to implicate particular carcinogens and the use of molecular markers to predict which individuals are at highest risk for a disease are common examples.</dd>
                </span>
            
            <dt>Entry Version</dt><dd>MOL EPIDEMIOL</dd>
        
                <dt>Entry Term(s)</dt>
                <dd>
                    Epidemiology, Molecular
                    
                </dd><dd>
                    Genetic Epidemiology
                    
                </dd>
            <dt>NLM Classification #</dt>
            <dd>WA 950</dd>
        
            <dt>Public MeSH Note</dt><dd>2010; see EPIDEMIOLOGY, MOLECULAR 1994-2009</dd>
        
            <dt>History Note</dt><dd>2010 (1994)</dd>
        
        


        
                <dt>Date Introduced</dt>
                <dd>1994/01/01</dd>
            
                <dt>Last Updated</dt>
                <dd>2012/07/03</dd>
            

    </dl>

