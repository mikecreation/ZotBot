{"batchcomplete":true,"query":{"pages":[{"pageid":68265416,"ns":0,"title":"Armourstone","extract":"Armourstone is a generic term for broken stone with stone masses between 100 and 10,000 kilograms (220 and 22,050 lb) (very coarse aggregate) that is suitable for use in hydraulic engineering. Dimensions and characteristics for armourstone are laid down in European Standard EN13383.","description":"Broken stone (very course aggregate) used in hydraulic engineering","descriptionsource":"local"}]}}