{"batchcomplete":true,"query":{"pages":[{"pageid":1326926,"ns":0,"title":"Array processing","extract":"Array processing  is a wide area of research in the field of signal processing that extends from the simplest form of 1 dimensional line arrays to 2 and 3 dimensional array geometries. Array structure can be defined as a set of sensors that are spatially separated, e.g.","description":"Area of research in signal processing","descriptionsource":"local"}]}}