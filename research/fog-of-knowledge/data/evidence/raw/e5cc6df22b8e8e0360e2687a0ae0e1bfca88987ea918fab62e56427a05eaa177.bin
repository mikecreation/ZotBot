{"version":"6.9","hitCount":1,"request":{"queryString":"EXT_ID:42737450 AND SRC:MED","internalQuery":"EXT_ID:42737450 AND SRC:MED","resultType":"CORE","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"42737450","source":"MED","pmid":"42737450","pmcid":"PMC13565948","fullTextIdList":{"fullTextId":["PMC13565948"]},"doi":"10.3390/ijms27177546","title":"Association of &lt;i&gt;PDGFRB&lt;/i&gt;, &lt;i&gt;VEGFR2&lt;/i&gt;, and &lt;i&gt;TGFB1&lt;/i&gt; Gene Polymorphisms with Nintedanib Efficacy and Adverse Effects in Patients with Progressive Pulmonary Fibrosis.","authorString":"Djurdjevic N, Pjevic MD, Stjepanovic M, Colic N, Dimic-Janjic S, Jankovic J, Maric N, Zecevic A, Terzic M, Golubovic A, Milivojevic I, Omcikus M, Ilic B, Lukic K, Mijatovic S, Grk M.","authorList":{"author":[{"fullName":"Djurdjevic N","lastName":"Djurdjevic","firstName":"Natasa","initials":"N","authorId":{"type":"ORCID","value":"0000-0002-0825-4748"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."},{"affiliation":"Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}},{"fullName":"Pjevic MD","lastName":"Pjevic","firstName":"Marija Dusanović","initials":"MD","authorId":{"type":"ORCID","value":"0000-0002-3564-2623"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Human Genetics, Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}},{"fullName":"Stjepanovic M","lastName":"Stjepanovic","firstName":"Mihailo","initials":"M","authorId":{"type":"ORCID","value":"0000-0003-1787-1438"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."},{"affiliation":"Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}},{"fullName":"Colic N","lastName":"Colic","firstName":"Nikola","initials":"N","authorId":{"type":"ORCID","value":"0000-0001-6516-1970"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."},{"affiliation":"Centre for Radiology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Dimic-Janjic S","lastName":"Dimic-Janjic","firstName":"Sanja","initials":"S","authorId":{"type":"ORCID","value":"0000-0001-9989-3862"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."},{"affiliation":"Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}},{"fullName":"Jankovic J","lastName":"Jankovic","firstName":"Jelena","initials":"J","authorId":{"type":"ORCID","value":"0000-0001-8529-8624"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."},{"affiliation":"Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}},{"fullName":"Maric N","lastName":"Maric","firstName":"Nikola","initials":"N","authorId":{"type":"ORCID","value":"0000-0002-1103-5669"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Zecevic A","lastName":"Zecevic","firstName":"Andrej","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Terzic M","lastName":"Terzic","firstName":"Milica","initials":"M","authorId":{"type":"ORCID","value":"0009-0006-6837-5222"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Allergology and Immunology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Golubovic A","lastName":"Golubovic","firstName":"Aleksa","initials":"A","authorId":{"type":"ORCID","value":"0009-0004-2848-6521"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Milivojevic I","lastName":"Milivojevic","firstName":"Ivan","initials":"I","authorId":{"type":"ORCID","value":"0000-0002-3289-8148"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Omcikus M","lastName":"Omcikus","firstName":"Maja","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-6489-5187"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."},{"affiliation":"Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}},{"fullName":"Ilic B","lastName":"Ilic","firstName":"Branislav","initials":"B","authorId":{"type":"ORCID","value":"0000-0001-9350-2461"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."},{"affiliation":"Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}},{"fullName":"Lukic K","lastName":"Lukic","firstName":"Katarina","initials":"K","authorId":{"type":"ORCID","value":"0009-0001-4861-4189"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centre for Radiology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Mijatovic S","lastName":"Mijatovic","firstName":"Snjezana","initials":"S","authorId":{"type":"ORCID","value":"0009-0005-1807-4571"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia."}]}},{"fullName":"Grk M","lastName":"Grk","firstName":"Milka","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-7534-9608"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Human Genetics, Faculty of Medicine, University of Belgrade, 11000 Belgrade, Serbia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-6516-1970"},{"type":"ORCID","value":"0000-0001-8529-8624"},{"type":"ORCID","value":"0000-0001-9350-2461"},{"type":"ORCID","value":"0000-0001-9989-3862"},{"type":"ORCID","value":"0000-0002-0825-4748"},{"type":"ORCID","value":"0000-0002-1103-5669"},{"type":"ORCID","value":"0000-0002-3289-8148"},{"type":"ORCID","value":"0000-0002-3564-2623"},{"type":"ORCID","value":"0000-0002-6489-5187"},{"type":"ORCID","value":"0000-0002-7534-9608"},{"type":"ORCID","value":"0000-0003-1787-1438"},{"type":"ORCID","value":"0009-0001-4861-4189"},{"type":"ORCID","value":"0009-0004-2848-6521"},{"type":"ORCID","value":"0009-0005-1807-4571"},{"type":"ORCID","value":"0009-0006-6837-5222"}]},"journalInfo":{"issue":"17","volume":"27","journalIssueId":4248396,"dateOfPublication":"2026 Aug","monthOfPublication":8,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Int J Mol Sci","title":"International journal of molecular sciences","essn":"1422-0067","issn":"1422-0067","nlmid":"101092791","isoabbreviation":"Int J Mol Sci"},"printPublicationDate":"2026-08-01"},"pubYear":"2026","pageInfo":"7546","abstractText":"Progressive pulmonary fibrosis (PPF) comprises interstitial lung diseases characterized by progressive fibrosis and lung function decline. Nintedanib slows disease progression by inhibiting FGFR, VEGFR, and PDGFR signaling, but treatment response varies among patients. We investigated whether <i>VEGFR2</i>, <i>PDGFRB</i>, and <i>TGFB1</i> gene variants are associated with nintedanib treatment outcomes, including changes in pulmonary function, diffusing capacity and adverse effects. This prospective study included 75 patients with PPF diagnosed according to ATS/ERS/JRS/ALAT criteria and treated with nintedanib at the Clinic of Pulmonology, University Clinical Center of Serbia. Spirometry and diffusing capacity were assessed at baseline and after 6 and 12 months. Genotyping of <i>VEGFR2</i> rs2071559 and rs1870377; <i>PDGFRB</i> rs2302273, rs2229562, and rs246395; and <i>TGFB1</i> rs1800470 was performed using TaqMan<sup>®</sup> assays. Carriers of the <i>PDGFRB</i> rs2302273 A allele more frequently experienced gastrointestinal adverse events (45.2% vs. 20.5%; <i>p</i> = 0.022; OR 3.2, 95% CI 1.156-8.866) and diarrhea (38.7% vs. 15.9%; <i>p</i> = 0.026; OR 3.3, 95% CI 1.129-9.869). Patients with the <i>PDGFRB</i> rs246395 TT genotype more frequently had a ≥15% decline in DLCO after one year (46% vs. 22%; <i>p</i> = 0.038; OR 3.0, 95% CI 1.045-8.394). No significant associations were observed for the analyzed <i>VEGFR2</i> or <i>TGFB1</i> variants. These findings suggest that <i>PDGFRB</i> variants may be associated with nintedanib treatment outcomes, although confirmation in larger cohorts is needed.","affiliation":"Clinic for Pulmonology, University Clinical Center of Serbia, 11000 Belgrade, Serbia.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"Ministry of Science, Technological Development, and Innovation","grantId":"451-03-66/2024-03/200110","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Pulmonary Fibrosis","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DT","qualifierName":"drug therapy"},{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Disease Progression"},{"majorTopic_YN":"Y","descriptorName":"Indoles","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AE","qualifierName":"adverse effects"},{"majorTopic_YN":"N","abbreviation":"TU","qualifierName":"therapeutic use"}]}},{"majorTopic_YN":"Y","descriptorName":"Receptor, Platelet-Derived Growth Factor beta","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Vascular Endothelial Growth Factor Receptor-2","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Treatment Outcome"},{"majorTopic_YN":"N","descriptorName":"Prospective Studies"},{"majorTopic_YN":"N","descriptorName":"Genotype"},{"majorTopic_YN":"Y","descriptorName":"Polymorphism, Single Nucleotide"},{"majorTopic_YN":"N","descriptorName":"Aged"},{"majorTopic_YN":"N","descriptorName":"Middle Aged"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"Y","descriptorName":"Transforming Growth Factor beta1","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}}]},"keywordList":{"keyword":["Adverse effects","Polymorphisms","Pharmacogenetics","Vegfr2","Tgfb1","Pdgfrb","Nintedanib","Progressive Pulmonary Fibrosis"]},"chemicalList":{"chemical":[{"name":"transforming growth factor beta1","registryNumber":"0"},{"name":"Indoles","registryNumber":"0"},{"name":"TGFB1 protein, human","registryNumber":"0"},{"name":"Vascular Endothelial Growth Factor Receptor-2","registryNumber":"EC 2.7.10.1"},{"name":"Receptor, Platelet-Derived Growth Factor beta","registryNumber":"EC 2.7.10.1"},{"name":"nintedanib","registryNumber":"G6HRD2P839"},{"name":"KDR protein, human","registryNumber":"EC 2.7.10.1"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/ijms27177546"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13565948"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13565948?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-09-15","dateOfCreation":"2026-09-15","dateOfRevision":"2026-09-16","electronicPublicationDate":"2026-08-23","firstPublicationDate":"2026-08-23","firstIndexDate":"2026-09-15","fullTextReceivedDate":"2026-09-13","hasEvaluations":"N"}]}}