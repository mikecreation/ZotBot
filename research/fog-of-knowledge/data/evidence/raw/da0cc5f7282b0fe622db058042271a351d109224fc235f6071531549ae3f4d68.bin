details.scisum-block summary{
	font-weight:bold
}
details.scisum-block summary span{
	font-weight:normal;
}
.scisum-block p{
	margin-top:0;
	display:inline-block;
	margin-right:0.5em;
}

/* only appear in edit mode*/
.dev-only{
	display:none;
	border:red solid 1px;
}

/* Example: Turn text pink */
.pink{
	color:pink;
}a{
cursor:pointer;
}


/*Increase size of nav items*/
.wp-block-navigation-item__content{
   font-size:1.33rem !important;
}


/*Remove submenu arrow*/
.wp-block-navigation__submenu-container li:not(.wp-block-navigation-submenu) a:before{
    display:none !important;
}

.wp-block-navigation__container > .wp-block-navigation-item {
   padding-bottom:0 !important;
} 


.wp-block-navigation__responsive-container-content{
   align-items:flex-end !important
}


.wp-block-social-links{
padding-bottom:8px !important;
}


