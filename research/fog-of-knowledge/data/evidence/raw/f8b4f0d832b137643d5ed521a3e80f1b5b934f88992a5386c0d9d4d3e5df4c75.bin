    <dl id="descriptorDetails_SleepWakeDisorders"
        class="dl-horizontal">

        <dt>MeSH Heading      </dt>

        <dd>Sleep Wake Disorders</dd>

        
                    <dt>Tree Number(s)</dt>
                    
                        <dd><a id="treeNumber_0" onclick=
                               "switchTab([ 'trees', 'treesTabContent' ])"
                            >C10.886</a></dd>
                    
                        <dd><a id="treeNumber_1" onclick=
