    document.addEventListener("DOMContentLoaded", () => {

        try {

            if (coopmsg
                && !/(^|; *)shutdown-banner=/.test(document.cookie))

                document.querySelector(
                    "body > div"
                ).insertAdjacentHTML(
                    "afterbegin",
                    "<div id='shutdown-banner'><p>" + coopmsg
                    + "</p><button type='button' role='button'"
                    + " aria-label='Close' onclick='"
                    + 'document.getElementById("shutdown-banner")'
                    + '.remove(); document.cookie ='
                    + ' "shutdown-banner=hidden; path=/";'
                    + "'>Close</button></div>"
                );

        } catch (error) {
            /* The "coopmsg" variable is only defined during a
             * shutdown. */
            if (!(error instanceof ReferenceError))
                throw error;
        }

    });

    var dcmsLinks = false,
        dcmsParam = dcmsLinks
                    ? function (sep) { return sep + "dcmsLinks=true"; }
                    : function (   ) { return ""                    ; };

</script>

