{"numberOfHits":1,"results":[{"id":"GO:0097596","isObsolete":false,"name":"ventral disc supernumerary microtubule array","definition":{"text":"A partial left-handed spiral array of microtubules that lies generally dorsal to the main ventral disc microtubule array in Giardia species (trophozoite stage).","xrefs":[{"dbCode":"ISBN","dbId":"9780124260207"}]},"comment":"Due to the asymmetric nature of the Giardia trophozoite, this term is defined spatially as the trophozoite is viewed from the dorsal side, with the two nuclei dorsal to the ventral disc, and the ventral disc toward the anterior.","synonyms":[{"name":"supernumerary microtubule array","type":"broad"},{"name":"ventral disk supernumerary microtubule array","type":"related"}],"history":[{"timestamp":"2024-03-05","action":"Added","category":"CONSTRAINT","text":"Bad taxon ID"},{"timestamp":"2019-09-12","action":"Added","category":"RELATION","text":"is a GO:0110165 (cellular anatomical structure)"},{"timestamp":"2019-09-12","action":"Deleted","category":"RELATION","text":"is a GO:0044422 (obsolete organelle part)"},{"timestamp":"2014-04-06","action":"Added","category":"RELATION","text":"is a GO:0044422 (obsolete organelle part)"},{"timestamp":"2014-04-06","action":"Added","category":"RELATION","text":"part of GO:0097597 (ventral disc)"},{"timestamp":"2014-04-06","action":"Added","category":"TERM","text":"ventral disc supernumerary microtubule array"},{"timestamp":"2014-04-06","action":"Added","category":"DEFINITION","text":"A partial left-handed spiral array of microtubules that lies generally dorsal to the main ventral disc microtubule array in Giardia species (trophozoite stage)."},{"timestamp":"2014-04-06","action":"Added","category":"SYNONYM","text":"supernumerary microtubule array"},{"timestamp":"2014-04-06","action":"Added","category":"SYNONYM","text":"ventral disk supernumerary microtubule array"}],"taxonConstraints":[{"ancestorId":"GO:0097596","ancestorName":"ventral disc supernumerary microtubule array","relationship":"only_in_taxon","taxId":"5740","taxIdType":"NCBITaxon","taxName":"Giardia"}],"aspect":"cellular_component","usage":"Unrestricted","blacklist":[{"goId":"GO:0097596","reason":"1 NOT-qualified manual annotation exists with evidence code ECO:0000314 from this reference: PMID:17766466","category":"NOT-qualified manual","entityType":"protein","entityId":"E2RU10","taxonId":"184922","entityName":"EB1_GIAIC","ancestorGoId":"GO:0097597"}]}],"pageInfo":null}