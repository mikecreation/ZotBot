,&q;distribution&q;:&q;PUBLIC&q;,&q;submittedDate&q;:&q;2013-08-13T04:31:00.0000000+00:00&q;,&q;authorAffiliations&q;:[{&q;sequence&q;:0,&q;submissionId&q;:19870046673,&q;meta&q;:{&q;author&q;:{&q;name&q;:&q;Wu, M. K.&q;},&q;organization&q;:{&q;name&q;:&q;Alabama Univ.&q;,&q;location&q;:&q;Huntsville, AL, United States&q;}},&q;id&q;:&q;1078a24842e644509055e913c4c8c8f2&q;},{&q;sequence&q;:1,&q;submissionId&q;:19870046673,&q;meta&q;:{&q;author&q;:{&q;name&q;:&q;Ashburn, J. R.&q;},&q;organization&q;:{&q;name&q;:&q;Alabama Univ.&q;,&q;location&q;:&q;Huntsville, AL, United States&q;}},&q;id&q;:&q;edcc05b33f0048b684dbd1868a72eec8&q;},{&q;sequence&q;:2,&q;submissionId&q;:19870046673,&q;meta&q;:{&q;author&q;:{&q;name&q;:&q;Torng, C. J.&q;},&q;organization&q;:{&q;name&q;:&q;Alabama, University&q;,&q;location&q;:&q;Huntsville, United States&q;}},&q;id&q;:&q;b9eaa4fe690e4950b98722e8b95d936c&q;},{&q;sequence&q;:3,&q;submissionId&q;:19870046673,&q;meta&q;:{&q;author&q;:{&q;name&q;:&q;Hor, P. H.&q;},&q;organization&q;:{&q;name&q;:&q;Alabama Univ.&q;,&q;location&q;:&q;Huntsville, AL, United States&q;}},&q;id&q;:&q;18111649ac1e492f99590fe1692705a8&q;},{&q;sequence&q;:4,&q;submissionId&q;:19870046673,&q;meta&q;:{&q;author&q;:{&q;name&q;:&q;Meng, R. L.&q;},&q;organization&q;:{&q;name&q;:&q;Houston, University&q;,&q;location&q;:&q;TX, United States&q;}},&q;id&q;:&q;322bb7e4cbcb4535ad40550c100ebecb&q;}],&q;stiTypeDetails&q;:&q;Reprint (Version printed in journal)&q;,&q;technicalReviewType&q;:&q;TECHNICAL_REVIEW_TYPE_NONE&q;,&q;modified&q;:&q;2025-08-31T18:39:21.7150190+00:00&q;,&q;id&q;:19870046673,&q;sourceIdentifiers&q;:[{&q;number&q;:&q;doi:10.1103/PhysRevLett.58.908&q;,&q;submissionId&q;:19870046673,&q;id&q;:&q;46cd451de04448ca82f161ec84c68acf&q;,&q;type&q;:&q;DOI&q;},{&q;submissionId&q;:19870046673,&q;id&q;:&q;5408d7b7564c4f449816e41d8b98bc4a&q;,&q;descriptor&q;:&q;doi:10.1103/PhysRevLett.58.908&q;}],&q;legacyMeta&q;:{&q;__type&q;:&q;LegacyMetaIndex, StrivesApi.ServiceModel&q;,&q;accessionNumber&q;:&q;87A33947&q;},&q;created&q;:&q;2013-08-13T04:31:00.0000000+00:00&q;,&q;center&q;:{&q;code&q;:&q;CDMS&q;,&q;name&q;:&q;Legacy CDMS&q;,&q;id&q;:&q;092d6e0881874968859b972d39a888dc&q;},&q;onlyAbstract&q;:false,&q;sensitiveInformation&q;:2,&q;abstract&q;:&q;A stable and reproducible superconductivity transition between 80 and 93 K has been achieved and maintained in a Y-Ba-Cu-O compound system at ambient pressure in a simple liquid-nitrogen Dewar. An upper critical field Hc2(0) estimate of between 80 and 180 T is obtained, and the paramagnetic limiting field at 0 K for a sample with a T(c) of about 90 K is 165 T. It is suggested that the lattice parameters, the valence ratio, and the sample treatments all play a role in achieving superconductivity above 77 K.&q;,&q;isLessonsLearned&q;:false,&q;disseminated&q;:&q;METADATA_ONLY&q;,&q;publications&q;:[{&q;volume&q;:&q;58&q;,&q;submissionId&q;:19870046673,&q;issn&q;:&q;0031-9007&q;,&q;id&q;:&q;9acc2abcc8e74a21bfc11405abfc28e6&q;,&q;publicationName&q;:&q;Physical Review Letters&q;,&q;publicationDate&q;:&q;1987-03-02T00:00:00.0000000+00:00&q;}],&q;status&q;:&q;CURATED&q;,&q;related&q;:[],&q;downloads&q;:[],&q;downloadsAvailable&q;:false,&q;index&q;:&q;submissions-2026-10-08-04-13&q;},&q;G.json./api/citations/19870046673?&q;:{&q;body&q;:{&q;copyright&q;:{&q;thirdPartyPermissionsProduced&q;:false,&q;disclosedToPublic&q;:false,&q;containsIndication&q;:false,&q;publisherPermissionOrRightsToDistribute&q;:false,&q;belongsToUsGov&q;:false,&q;determinationType&q;:&q;OTHER&q;,&q;thirdPartyContentCondition&q;:&q;NOT_SET&q;,&q;belongsToContractor&q;:false,&q;disclosedInvention&q;:false,&q;submissionId&q;:19870046673,&q;containsThirdPartyMaterial&q;:false,&q;belongsToPublisher&q;:false,&q;id&q;:&q;37e252150ff74bab851aeb191c158ab5&q;,&q;belongsToAuthors&q;:false},&q;subjectCategories&q;:[&q;Solid-State Physics&q;],&q;exportControl&q;:{&q;isExportControl&q;:&q;NO&q;,&q;submissionId&q;:19870046673,&q;ear&q;:&q;NO&q;,&q;