{"batchcomplete":true,"query":{"pages":[{"pageid":13903462,"ns":0,"title":"Condenser (heat transfer)","extract":"In systems involving heat transfer, a condenser is a heat exchanger used to condense a gaseous substance into a liquid state through cooling. In doing so, the latent heat is released by the substance and transferred to the surrounding environment.","description":"System for condensing gas into liquid by cooling","descriptionsource":"local"}]}}