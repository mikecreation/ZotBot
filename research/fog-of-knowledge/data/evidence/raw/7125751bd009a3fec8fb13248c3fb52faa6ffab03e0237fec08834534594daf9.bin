<tr><td colspan="5"><table width="100%"><tr><td colspan="3" style="vertical-align:bottom;font-family:arial;font-size:13" align="left"><A HREF="https://vocab.getty.edu/aat/300022208"><u>Semantic View</u></A>&nbsp;(<A HREF="https://vocab.getty.edu/aat/300022208.json"><u>JSON</u></A>,&nbsp;<A HREF="https://vocab.getty.edu/aat/300022208.rdf"><u>RDF</u></A>,&nbsp;<A HREF="https://vocab.getty.edu/aat/300022208.ttl"><u>N3/Turtle</u></A>,&nbsp;<A HREF="https://vocab.getty.edu/aat/300022208.nt"><u>N-Triples</u></A>)</td></tr><tr><TD COLSPAN=3 NOWRAP><SPAN CLASS=page><BR><B>ID: 300022208</B><BR><B>Page Link:</B> http://vocab.getty.edu/page/aat/300022208</SPAN><BR>&nbsp;</TD>
<TD ALIGN=RIGHT VALIGN=TOP NOWRAP COLSPAN=2><SPAN CLASS=page><BR><B>Record Type:</B> <A HREF="javascript:code_lookup('record_type','RTC')">concept</A></SPAN></TD>
