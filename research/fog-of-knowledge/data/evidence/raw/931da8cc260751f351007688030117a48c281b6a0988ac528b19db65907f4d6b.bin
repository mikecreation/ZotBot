{"batchcomplete":true,"query":{"pages":[{"pageid":1535731,"ns":0,"title":"Fictionalism","extract":"Fictionalism is a view in philosophy that posits that statements appearing to be descriptions of the world should not be construed as such, but should instead be understood as cases of \"make believe\", thus allowing individuals to treat something as literally true (a \"useful fiction\").","description":"Pretending to treat something as literally true (a \"useful fiction\")","descriptionsource":"local"}]}}