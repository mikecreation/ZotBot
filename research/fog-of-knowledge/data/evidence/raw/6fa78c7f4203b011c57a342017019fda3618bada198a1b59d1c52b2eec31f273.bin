{"batchcomplete":true,"query":{"pages":[{"pageid":6308558,"ns":0,"title":"Analysis of competing hypotheses","extract":"The analysis of competing hypotheses (ACH) is a methodology for evaluating multiple competing hypotheses for observed data. It was developed by Richards (Dick) J. Heuer, Jr., a 45-year veteran of the Central Intelligence Agency, in the 1970s for use by the Agency.","description":"Process to evaluate alternative hypotheses","descriptionsource":"local"}]}}