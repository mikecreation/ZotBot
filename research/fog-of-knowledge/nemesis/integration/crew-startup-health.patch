+def test_snapshot_integrity_scan_allows_live_commit_and_checks_fresh_heartbeat(database, monkeypatch):
+    ready = threading.Event()
+    release = threading.Event()
+    original = supervisor.database_health
+    scanned_paths = []
+    def paused_snapshot(connection, science_running=False, deadline=None):
+        scanned_paths.append(connection.execute('PRAGMA database_list').fetchone()[2])
+        hold_integrity_scan(connection, ready, release)
+        return original(connection, science_running=False)
+    monkeypatch.setattr(supervisor, 'database_health', paused_snapshot)
+    thread, result, errors = run_thread(lambda: supervisor.snapshot_database_health(True, time.monotonic() + 5))
+    try:
+        assert ready.wait(2)
+        with sqlite3.connect(database, timeout=.05) as writer:
+            writer.execute('UPDATE payload SET body=? WHERE id=1', (b'changed while verifying',))
+            writer.execute('UPDATE campaign_scheduler_heartbeats SET last_pass=?', (time.time(),))
+    finally:
+        release.set()
+        thread.join(3)
+    assert not thread.is_alive() and not errors and result == [True]
+    assert scanned_paths and scanned_paths[0] != str(database)
+    assert not Path(scanned_paths[0]).exists(), 'Temporary snapshot is cleaned up'
+    with sqlite3.connect(database) as connection:
+        assert connection.execute('PRAGMA journal_mode').fetchone()[0] == 'delete'
+        assert connection.execute('SELECT body FROM payload WHERE id=1').fetchone()[0] == b'changed while verifying'
