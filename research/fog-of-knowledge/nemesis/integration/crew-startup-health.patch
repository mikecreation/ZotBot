+        with closing(sqlite3.connect(path)) as connection:
+            assert connection.execute('SELECT COUNT(*) FROM payload').fetchone()[0] == 650
+            assert connection.execute('SELECT COUNT(*) FROM payload WHERE body=?', (b'x' * 4096,)).fetchone()[0] == 650
+            assert connection.execute('SELECT COUNT(*) FROM payload WHERE id=10000').fetchone()[0] == 0
