+"""Real isolated compiler subprocesses preserve scientific Unicode on Windows."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from sim.github_sandbox import execute
+
+
+@pytest.mark.parametrize('rationale', [
+    '4.2\u00b10.1 tonne-years',
+    '\u039bCDM \u2014 \u03bc = 0.1',
+    '\u91cf\u5b50\u91cd\u529b',
+])
+def test_isolated_compiler_unicode_roundtrip(tmp_path, monkeypatch, rationale):
+    monkeypatch.setenv('PYTHONIOENCODING', 'cp1252')
+    scripts=tmp_path/'scripts';scripts.mkdir()
+    script=scripts/'unicode_fixture.py'
+    script.write_text(
+        'import json, sys\n'
+        'rationale = '+ascii(rationale)+'\n'
+        'print(json.dumps({"rationale":rationale},ensure_ascii=False))\n'
+        'print(rationale,file=sys.stderr)\n',encoding='utf-8')
+    result=execute(tmp_path,'scripts/unicode_fixture.py',[])
+    assert result['exit_code']==0, result
+    assert result['error'] is None
+    assert json.loads(result['stdout'])['rationale']==rationale
+    assert result['stderr'].strip()==rationale
+    assert '\ufffd' not in result['stdout']+result['stderr']
+
+
+def test_invalid_compiler_stdout_cannot_be_accepted_with_replacement(tmp_path):
+    result=execute(tmp_path,'scripts/fixture.py',[],runner=lambda *a,**kw:
+                   SimpleNamespace(returncode=0,stdout=b'{"rationale":"4.2\xb10.1"}',stderr=b''))
+    assert result['exit_code']!=0
+    assert 'not valid UTF-8' in result['error']
+
+
+def test_non_utf8_diagnostic_does_not_discard_valid_compiler_response(tmp_path):
+    result=execute(tmp_path,'scripts/fixture.py',[],runner=lambda *a,**kw:
+                   SimpleNamespace(returncode=0,stdout=b'{"ok":true}',stderr=b'legacy diagnostic: \xb1'))
+    assert result['exit_code']==0
+    assert result['error'] is None
+    assert json.loads(result['stdout'])=={'ok':True}
+    assert result['stderr'].startswith('legacy diagnostic: ')
