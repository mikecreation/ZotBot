+        # verified stopped-child boundary only, let SQLite recover it normally
+        # before copying; readonly opens cannot perform that atomic recovery.
+        # mode=rw refuses a missing source and we never issue data writes.
+        source=sqlite3.connect(DB.resolve().as_uri()+'?mode=rw',uri=True,timeout=.2)
