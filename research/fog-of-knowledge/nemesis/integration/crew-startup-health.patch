+    if result.returncode:raise RuntimeError('Cannot verify owned application process descendants')
+    rows=json.loads(result.stdout)
+    return {int(row['ProcessId']):{'pid':int(row['ProcessId']),'parent':int(row['ParentProcessId']),'created':row['CreationDate']} for row in (rows if isinstance(rows,list) else [rows])}
+
+
+def descendants(rows,roots):
+    owned={pid:rows[pid] for pid in roots if pid in rows}
+    while True:
+        added={pid:row for pid,row in rows.items() if row['parent'] in owned and pid not in owned}
+        if not added:return owned
+        owned.update(added)
+
+
+def stop_windows_descendants(proc):
+    rows=windows_processes();saved=_OWNED_DESCENDANTS.get(id(proc),{})
+    # A live Popen handle proves the wrapper is still ours. For an exited
+    # wrapper only previously captured, creation-matching descendants qualify.
+    running=proc.poll() is None
+    if running and proc.pid not in rows:raise RuntimeError('Cannot verify live owned wrapper before restart')
+    roots=[proc.pid] if running else [pid for pid,row in saved.items() if pid in rows and rows[pid]['created']==row['created']]
+    owned=descendants(rows,roots)
+    if any(not row.get('created') for row in owned.values()):raise RuntimeError('Cannot verify owned process creation identity')
+    if proc.poll() is not None:owned.pop(proc.pid,None)
+    for pid,row in sorted(owned.items(),key=lambda item:item[0]==proc.pid):
+        current=windows_processes().get(pid)
+        if current is None:continue
+        if current['created']!=row['created']:raise RuntimeError('Owned child PID was reused; refusing unverified termination')
+        result=subprocess.run(['taskkill','/PID',str(pid),'/T','/F'],capture_output=True,text=True,timeout=8,
+                              creationflags=getattr(subprocess,'CREATE_NO_WINDOW',0))
+        if result.returncode and windows_processes().get(pid)==current:raise RuntimeError('Owned application child did not stop')
+    deadline=time.monotonic()+9
+    while time.monotonic()<deadline:
+        current=windows_processes()
+        if not any(pid in current and current[pid]['created']==row['created'] for pid,row in owned.items()):
+            _OWNED_DESCENDANTS.pop(id(proc),None);return
+        time.sleep(.1)
+    raise RuntimeError('Owned application descendants still hold the restart boundary')
+
+
+def discard_restart_snapshot(proc):
