+def run_thread(function):
+    result = []
+    errors = []
+    def run():
+        try:
+            result.append(function())
+        except BaseException as exc:
+            errors.append(exc)
+    thread = threading.Thread(target=run)
+    thread.start()
+    return thread, result, errors
+
+
+def hold_integrity_scan(connection, ready, release):
+    first = [True]
+    def progress():
+        if first:
+            first.pop()
+            ready.set()
+            if not release.wait(3):
+                raise TimeoutError('Test did not release the paused integrity scan')
+        return 0
+    connection.set_progress_handler(progress, 50)
+
+
+def test_old_live_integrity_scan_reproduces_commit_database_locked(database):
+    ready = threading.Event()
+    release = threading.Event()
+    def health():
+        connection = sqlite3.connect(database)
+        try:
+            hold_integrity_scan(connection, ready, release)
+            return supervisor.database_health(connection)
+        finally:
+            connection.close()
+    thread, result, errors = run_thread(health)
+    try:
+        assert ready.wait(2)
+        writer = sqlite3.connect(database, timeout=.05)
+        try:
+            writer.execute('UPDATE payload SET body=? WHERE id=1', (b'changed',))
+            with pytest.raises(sqlite3.OperationalError, match='database is locked'):
+                writer.commit()
+            writer.rollback()
+        finally:
+            writer.close()
+    finally:
+        release.set()
+        thread.join(3)
+    assert not thread.is_alive() and not errors and result == [True]
+
