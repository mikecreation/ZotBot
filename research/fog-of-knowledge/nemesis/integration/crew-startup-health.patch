+def test_incremental_snapshot_releases_source_lock_between_page_steps(database, monkeypatch):
+    ready = threading.Event()
+    release = threading.Event()
+    first = [True]
+    original_connect = sqlite3.connect
+    with original_connect(database) as connection:
+        connection.executemany('INSERT INTO payload(body) VALUES(?)', [(b'x' * 4096,)] * 5000)
+    class Connection(sqlite3.Connection):
+        def backup(self, target, **kwargs):
+            original_progress = kwargs['progress']
+            def progress(status, remaining, total):
+                if first and remaining:
+                    first.pop()
+                    ready.set()
+                    assert release.wait(3)
+                original_progress(status, remaining, total)
+            kwargs['progress'] = progress
+            return super().backup(target, **kwargs)
+    def connect(*args, **kwargs):
+        kwargs['factory'] = Connection
+        return original_connect(*args, **kwargs)
+    monkeypatch.setattr(supervisor.sqlite3, 'connect', connect)
+    thread, result, errors = run_thread(lambda: supervisor.snapshot_database_health(False, time.monotonic() + 5))
+    try:
+        assert ready.wait(2)
+        with original_connect(database, timeout=.05) as writer:
+            writer.execute('UPDATE payload SET body=? WHERE id=2', (b'committed between backup steps',))
+    finally:
+        release.set()
+        thread.join(3)
+    assert not thread.is_alive() and not errors and result == [True]
+
