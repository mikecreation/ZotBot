+    monkeypatch.setattr(supervisor,'_RESTART_SNAPSHOTS',{})
+    monkeypatch.setattr(supervisor,'_OWNED_DESCENDANTS',{})
+    monkeypatch.setattr(supervisor,'_ACTIVE_CHILD',None)
+    yield
+    for proof in list(supervisor._RESTART_SNAPSHOTS.values()):
+        if proof.get('temporary'):proof['temporary'].cleanup()
