{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fog of Knowledge Graph",
  "type": "object",
  "required": [
    "meta",
    "eras",
    "domains",
    "nodes",
    "edges",
    "reviews"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "domain",
          "era",
          "status"
        ],
        "properties": {
          "status": {
            "enum": ["foundational", "established", "active", "disputed", "frontier", "invalidated", "historical", "reported"],
            "description": "reported attributes the scoped assertion to its retained source without claiming acceptance or current consensus."
          },
          "era": {
            "type": "string",
            "description": "One of graph.eras; undated explicitly leaves chronological placement unresolved."
          },
          "frontier": {
            "type": "boolean",
            "description": "false makes no positive claim of current frontier currency; true requires explicit evidence and review."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "type"
        ]
      }
    },
    "reviews": {
      "type": "array"
    }
  }
}
